  /// رشته‌ی تصادفی در مسیر وب‌هوک. بله `secret_token` ندارد، پس تنها راه
  /// محافظت، غیرقابل‌حدس بودن خودِ آدرس است.
  baleWebhookSecret String?
  /// API کسب‌وکاری بله (سهمیه‌ی نرخ بالاتر، هزینه‌دار) به‌جای API معمولی
  baleBusinessApi   Boolean @default(false)
  /// نشانگر getUpdates — فقط برای حالت بدون وب‌هوک (توسعه‌ی لوکال)
  baleUpdateOffset  Int?
  /// کلید سفیر — ارسال با «شماره تلفن» بدون اینکه کاربر /start زده باشد.
  /// ⚠️ این کلید با توکن ربات فرق دارد؛ از پنل کسب‌وکار بله گرفته می‌شود و
  ///    ارسال از آن هزینه‌دار است.
  baleSafirKey      String?
  baleSafirEnabled  Boolean @default(false)

  /// کلمه/عدد کلیدی رضایت با پاسخ پیامکی — مشتری این را به خط خدماتی می‌فرستد
  smsOptInText String? @default("عضویت")

  // ── کارتابل ─────────────────────────────────────────────────────
  /// پیش‌فرض خاموش: سایت‌های دیگر با دیپلوی بعدی منوی تازه نمی‌بینند.
  worklistEnabled        Boolean @default(false)
  /// سقف حضور روزانه بر حسب دقیقه — بیشتر از این یعنی یادش رفته خروج بزند،
  /// نه اینکه کار کرده. پیش‌فرض ده ساعت.
  worklistDailyCapMin    Int     @default(600)
  /// ساعت کاری هر روز هفته: [{ day: 0..6 (شنبه = ۰), open, start: "09:00", end: "18:00" }]
  /// آرایه‌ی خالی یعنی پیش‌فرض کد — lib/worklist/work-hours.ts
  worklistWorkHours      Json    @default("[]")
  /// «مشتری ثابت» برای قاعده‌ی تماس دوره‌ای: حداقل تعداد خرید و مبلغ کل (تومان)
  worklistLoyalMinOrders Int     @default(2)
  worklistLoyalMinSpent  BigInt  @default(0)
  /// بازارگاه‌های کارتابل: [{ key, label }] — خوراک فیلد `StaffTask.platform`.
  /// خالی یعنی هنوز تعریف نشده و انتخابگر پلتفرم چیزی نشان نمی‌دهد.
  worklistPlatforms      Json    @default("[]")
}

