  /// کارِ کارتابل که از این درخواست ساخته شد.
  /// رابطه نیست تا حذف کار، درخواست را نشکند — درخواست تماس سند مشتری است.
  taskId         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([siteId])
  @@index([status])
  @@index([createdAt])
  @@index([siteId, status])
}

// ═══════════════════════════════════════════════════════════════════
// INTEGRATION HUB
// ═══════════════════════════════════════════════════════════════════

// ── پلتفرم‌های تعریف‌شده (seeded) ───────────────────────────────────

model IntegPlatform {
  code     String            @id
  name     String
  type     IntegPlatformType
  logoUrl  String?
  isActive Boolean           @default(true)

  connections      IntegConnection[]
  suggestions      IntegMappingSuggestion[]
  jobs             IntegJob[]
  logs             IntegLog[]
  platformProducts IntegPlatformProduct[]
  chats            IntegChat[]
}

enum IntegPlatformType {
  ACCOUNTING
  MARKETPLACE
}

// ── محصولات دریافت‌شده از هر پلتفرم ────────────────────────────────

model IntegPlatformProduct {
  id                String    @id @default(cuid())
  platformCode      String
  platformProductId String
  title             String
  sku               String?
  barcode           String?
  stock             Float?
  price             Float?
  originalPrice     Float? // قیمت پیش از تخفیف — null یعنی تخفیفی نیست
  discountPercent   Float? // درصد تخفیف فعال روی پلتفرم
  discountStartsAt  DateTime?
  discountEndsAt    DateTime?
  discountStock     Int? // موجودی اختصاصی تخفیف (اسنپ‌شاپ)
  // آیا این ردیف بعد از افزوده‌شدن ردیابی تخفیف، تازه‌سازی شده؟
  // ردیف‌های قدیمی false می‌مانند؛ تا وقتی «دریافت محصولات» اجرا نشود
  // نمی‌دانیم محصول تخفیف دارد یا نه، پس قیمت برایش ارسال نمی‌شود.
  discountSynced    Boolean   @default(false)
  purchasePrice     Float?
  unit              String?
  isEnabled         Boolean   @default(true)
  rawData           Json      @default("{}")
  lastFetchedAt     DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  platform IntegPlatform @relation(fields: [platformCode], references: [code])

  @@unique([platformCode, platformProductId])
  @@index([platformCode])
  @@index([platformCode, isEnabled])
}

// ── اتصال به هر پلتفرم ──────────────────────────────────────────────

model IntegConnection {
  id               String          @id @default(cuid())
  platformCode     String
  siteId           String?
  credentials      String // JSON رمزنگاری‌شده AES-256-GCM
  status           IntegConnStatus @default(DISCONNECTED)
  lastSyncAt       DateTime?
  lastErrorAt      DateTime?
  lastError        String?
  config           Json            @default("{}")
  syncStockEnabled Boolean         @default(true)
  syncPriceEnabled Boolean         @default(false)
  syncIntervalMin  Int             @default(60)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  platform IntegPlatform @relation(fields: [platformCode], references: [code])

  @@unique([platformCode, siteId])
  @@index([status])
  @@index([platformCode])
}

enum IntegConnStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  SYNCING
}

// ── ظرف یکپارچه نگاشت (گروه چند پلتفرمه) ──────────────────────────

model IntegMapping {
  id               String    @id @default(cuid())
  notes            String?
  isActive         Boolean   @default(true)
  stock            Int       @default(0)
  syncStockEnabled Boolean   @default(true)
  lastStockSyncAt  DateTime?
  lastHesabanStock Int?

  purchasePriceSource IntegPurchasePriceSource @default(HESABAN)
  purchasePrice       Float?
  syncPriceEnabled    Boolean                  @default(true)
  lastPriceSyncAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links  IntegMappingLink[]
  orders IntegOrder[]
}

model IntegMappingLink {
  id            String   @id @default(cuid())
  mappingId     String
  platformCode  String // "shop" | "hesaban" | "basalam" | ...
  externalId    String // Product.id for "shop", platformProductId for others
  externalTitle String?
  isActive      Boolean  @default(true)
  meta          Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ── تخفیف تحت مدیریت پنل ───────────────────────────────────────
  // چرا اینجا و نه روی IntegMapping: هر بازارگاه تخفیف مستقل دارد و این جدول
  // دقیقاً یک ردیف به ازای هر (نگاشت، پلتفرم) است.
  // discountManaged = true یعنی پنل ما فرمانده است؛ هرچه در پنل بازارگاه
  // تنظیم شود در ارسال بعدی بازنویسی می‌شود. false یعنی تخفیف از کش
  // IntegPlatformProduct خوانده و حفظ می‌شود (رفتار قدیمی، حالا انتخابی).
  discountManaged   Boolean   @default(true)
  discountPercent   Float? // null یعنی تخفیفی تعریف نشده — ارسال، تخفیف را برمی‌دارد
  discountStartsAt  DateTime? // null یعنی از همین حالا
  discountEndsAt    DateTime? // null یعنی بی‌پایان؛ گذشته یعنی تخفیف حذف شود
  discountStock     Int? // موجودی اختصاصی تخفیف — فعلاً فقط اسنپ‌شاپ
  discountPushedAt  DateTime?
  discountPushError String?

  mapping IntegMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade)

  @@unique([mappingId, platformCode])
  @@unique([platformCode, externalId])
  @@index([mappingId])
  @@index([platformCode])
  @@index([platformCode, isActive])
}

// ── پیشنهادهای auto-match ────────────────────────────────────────────

model IntegMappingSuggestion {
  id                String                @id @default(cuid())
  shopProductId     String
  platformCode      String
  platformProductId String
  platformTitle     String?
  confidence        Float
  matchReason       String?
  status            IntegSuggestionStatus @default(PENDING)
  reviewedAt        DateTime?
  createdAt         DateTime              @default(now())

  platform IntegPlatform @relation(fields: [platformCode], references: [code])

  @@index([shopProductId])
  @@index([platformCode, status])
  @@index([confidence])
}

enum IntegSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

// ── سفارش‌های دریافت‌شده از مارکت‌پلیس‌ها ─────────────────────────────

model IntegOrder {
  id                  String           @id @default(cuid())
  mappingId           String?
  platformCode        String
  platformOrderId     String
  platformOrderNo     String? // شماره سفارش قابل نمایش برای کاربر (نه شناسه داخلی)
  platformOrderItemId String?
  productTitle        String
  qty                 Int
  unitPrice           Float?
  customerName        String?
  customerPhone       String?
  status              IntegOrderStatus @default(PENDING)
  blockedReason       String? // چرا فاکتور نخورد — برای نمایش در ادمین
  invoicedAt          DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  mapping IntegMapping? @relation(fields: [mappingId], references: [id])

  @@unique([platformCode, platformOrderId])
  @@index([mappingId])
  @@index([platformCode, status])
  @@index([status])
  @@index([createdAt])
}

enum IntegOrderStatus {
  PENDING
  NEEDS_MAPPING // محصول نگاشت حسابداری ندارد — منتظر اقدام ادمین
  INVOICED
  CANCELLED
}

// ── Queue ────────────────────────────────────────────────────────────

model IntegJob {
  id           String         @id @default(cuid())
  type         IntegJobType
  platformCode String
  payload      Json
  status       IntegJobStatus @default(PENDING)
  priority     Int            @default(5)
  attempts     Int            @default(0)
  maxAttempts  Int            @default(3)
  lastError    String?
  scheduledAt  DateTime       @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime       @default(now())

  platform IntegPlatform @relation(fields: [platformCode], references: [code])
  logs     IntegLog[]

  @@index([status, scheduledAt])
  @@index([platformCode, status])
  @@index([priority, scheduledAt])
  @@index([type])
}

enum IntegJobType {
  SYNC_STOCK
  SYNC_PRICE
  SYNC_ALL_STOCK
  SYNC_ALL_PRICE
  FETCH_PRODUCTS
  FETCH_ORDERS
  CREATE_INVOICE // ثبت فاکتور فروش در حسابداری (فقط برای لاگ)
  CREATE_PRODUCT
  TEST_CONNECTION
  FETCH_CHATS // دریافت گفت‌وگوها و پیام‌های بازارگاه
  SEND_MESSAGE // ارسال پاسخ ادمین به گفت‌وگوی بازارگاه
}

enum IntegJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
  RETRYING
  CANCELLED
}

// ── Log ──────────────────────────────────────────────────────────────

model IntegLog {
  id            String            @id @default(cuid())
  jobId         String?
  platformCode  String
  operationType IntegJobType
  direction     IntegLogDirection
  entityType    IntegEntityType
  entityId      String?
  requestData   Json?
  responseData  Json?
  status        IntegLogStatus
  errorMessage  String?
  durationMs    Int?
  createdAt     DateTime          @default(now())

  job      IntegJob?     @relation(fields: [jobId], references: [id])
  platform IntegPlatform @relation(fields: [platformCode], references: [code])

  @@index([platformCode, createdAt])
  @@index([entityType, entityId])
  @@index([status])
  @@index([jobId])
  @@index([createdAt])
}

enum IntegLogDirection {
  INBOUND
  OUTBOUND
}

enum IntegEntityType {
  PRODUCT
  STOCK
  PRICE
  ORDER
  CONNECTION
  CHAT
}

enum IntegLogStatus {
  SUCCESS
  ERROR
  PARTIAL
}

// ── قوانین قیمت‌گذاری ────────────────────────────────────────────────

model IntegPriceRule {
  id               String   @id @default(cuid())
  name             String
  description      String?
  isActive         Boolean  @default(true)
  priority         Int      @default(100)
  targetPlatforms  String[] @default([]) // خالی = همه پلتفرم‌ها (شامل shop هم می‌شود)
  scopeCategoryIds String[] @default([])
  scopeBrandIds    String[] @default([])

  feePercent     Float         @default(0)
  shippingType   IntegCostType @default(FIXED)
  shippingValue  Float         @default(0)
  packagingType  IntegCostType @default(FIXED)
  packagingValue Float         @default(0)
  miscType       IntegCostType @default(FIXED)
  miscValue      Float         @default(0)
  marginPercent  Float         @default(0) // سود پیش‌فرض — وقتی هیچ tier ای match نشود
  roundTo        Int?

  tiers IntegPriceRuleTier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, priority])
}

enum IntegCostType {
  FIXED
  PERCENT
}

model IntegPriceRuleTier {
  id            String @id @default(cuid())
  ruleId        String
  minStock      Int? // null = بدون حد پایین
  maxStock      Int? // null = بدون حد بالا
  marginPercent Float
  sortOrder     Int    @default(0)

  rule IntegPriceRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}

// ── گفت‌وگوهای بازارگاه ──────────────────────────────────────────────
// جدول‌ها از ابتدا چندپلتفرمی‌اند (platformCode)، ولی فعلاً فقط آداپتور باسلام
// آن‌ها را پر می‌کند. به docs/plans/basalam-chat.md نگاه کنید.

model IntegChat {
  id           String @id @default(cuid())
  platformCode String
  /// شناسه گفت‌وگو سمت پلتفرم — در باسلام همان chat_id عددی
  externalId   String

  /// private | group | channel | bot — کانال‌ها پیام مشتری نیستند و در پنل
  /// به‌طور پیش‌فرض نمایش داده نمی‌شوند.
  chatType      String  @default("private")
  contactId     String?
  contactName   String?
  contactAvatar String?

  unseenCount     Int       @default(0)
  lastMessageAt   DateTime?
  lastMessageText String?

  /// updated_at سمت پلتفرم — مکان‌نمای همگام‌سازی افزایشی
  externalUpdatedAt DateTime?
  /// بزرگ‌ترین شناسه پیامی که تا الان کشیده‌ایم
  lastFetchedMsgId  String?

  raw       Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  platform IntegPlatform      @relation(fields: [platformCode], references: [code])
  messages IntegChatMessage[]

  @@unique([platformCode, externalId])
  @@index([platformCode, lastMessageAt])
  @@index([chatType])
}

model IntegChatMessage {
  id         String  @id @default(cuid())
  chatId     String
  /// شناسه پیام سمت پلتفرم. برای پیام خروجی تا لحظه ارسال موفق خالی است.
  externalId String?

  /// IN = از مشتری، OUT = از غرفه
  direction  String
  senderId   String?
  senderName String?

  messageType String  @default("text")
  text        String? @db.Text
  files       Json    @default("[]")

  seenAt DateTime?
  sentAt DateTime

  /// فقط برای پیام‌های خروجی: SYNCED | PENDING | SENT | FAILED
  sendStatus String  @default("SYNCED")
  sendError  String?

  raw       Json     @default("{}")
  createdAt DateTime @default(now())

  chat IntegChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, externalId])
  @@index([chatId, sentAt])
  @@index([sendStatus])
}

// ── تنظیمات کلی ──────────────────────────────────────────────────────

model IntegSettings {
  id                String   @id @default("singleton")
  workerEnabled     Boolean  @default(true)
  workerIntervalSec Int      @default(30)
  maxConcurrentJobs Int      @default(5)
  logRetentionDays  Int      @default(30)
  updatedAt         DateTime @updatedAt
}

enum IntegPurchasePriceSource {
  HESABAN
  MANUAL
}

// ═══════════════════════════════════════════════════════════════════
// CUSTOMER CLUB — باشگاه مشتریان
// ═══════════════════════════════════════════════════════════════════

/// منبع *جذب* عضو — از کجا آمد. با «کانال ارتباطی» (ClubChannel) فرق دارد:
/// یکی می‌گوید از کجا آمد، دیگری می‌گوید از چه راهی به او برسیم.
enum ClubSource {
  ONLINE // ثبت‌نام از سایت
  IN_STORE // ثبت توسط فروشنده
  CALLER_ID // دستگاه شماره‌گیر
  IMPORT // ورود از فایل
  MARKETPLACE // باسلام / تپسی‌شاپ / اسنپ‌شاپ / دیجی‌کالا / دیوار
  MESSAGING // تلگرام / بله — عضویت از ربات پیام‌رسان
  REFERRAL // معرفی توسط عضو دیگر
}

/// کانال ارتباطی — از چه راهی می‌شود به عضو پیام رساند.
/// ⚠️ عمداً از ClubSource جداست: عضوی که از باسلام آمده ممکن است بعداً در
///    تلگرام هم عضو شود؛ با یک enum مشترک یکی از این دو گم می‌شد.
enum ClubChannel {
  SMS
  TELEGRAM
  BALE
}

enum PointReason {
  PURCHASE
  MANUAL
  SIGNUP
  BIRTHDAY
  REFERRAL
  REVIEW
  CONSENT
  REDEEM
  EXPIRE
  ADJUST
}

model ClubProfile {
  id             String      @id @default(cuid())
  userId         String      @unique
  birthDate      DateTime?
  birthMonth     Int? // ماه شمسی ۱-۱۲ — برای کوئری سریع کمپین تولد
  birthDay       Int? // روز شمسی ۱-۳۱
  gender         String?
  source         ClubSource  @default(ONLINE)
  sourcePlatform String? // وقتی source = MARKETPLACE → "basalam" | "tapsi_shop"
  /// کد معرفی اختصاصی این عضو — با اولین درخواست ساخته می‌شود
  referralCode   String?     @unique
  /// عضوی که این شخص را معرفی کرده
  referredById   String?
  referredAt     DateTime?
  /// اولین نقطه‌ی تماس — ⚠️ هرگز بازنویسی نمی‌شود. مبنای گزارش «جذب از هر
  /// پلتفرم» است؛ `source` می‌تواند با فعالیت بعدی عضو عوض شود ولی این نه.
  firstSource    ClubSource?
  firstPlatform  String?
  firstSeenAt    DateTime?
  registeredById String? // شناسه فروشنده‌ای که ثبت کرده

  /// ── مالکیت کارتابل (فاز ۸) — کارمندی که صاحب این مشتری است ──
  /// ⚠️ تصاحب خودکار فقط روی مشتریِ بی‌صاحب. جابه‌جایی فقط صریح و با ردیف
  /// `ClubOwnerTransfer`. مستندات: docs/features/staff-worklist.md بخش ۲۱
  ownerId        String?
  /// اسنپ‌شات نام مالک — تله‌ی ۴
  ownerName      String?
  claimedVia     StaffClaimSource?
  claimedAt      DateTime?
  /// کارِ تماسی که باعث تصاحب شد
  claimTaskId    String?
  categoryId     String?
  tierId         String?
  totalSpent     BigInt            @default(0)
  orderCount     Int               @default(0)
  lastPurchaseAt DateTime?
  smsConsent     Boolean           @default(false)
  consentAt      DateTime?
  consentIp      String?
  isBlocked      Boolean           @default(false)
  tags           String[]          @default([])
  note           String?
  joinedAt       DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier           ClubTier?             @relation(fields: [tierId], references: [id])
  owner          User?                 @relation("ClubProfileOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  category       ClubCustomerCategory? @relation(fields: [categoryId], references: [id])
  ownerTransfers ClubOwnerTransfer[]
  points         PointTransaction[]
  touchpoints    ClubTouchpoint[]
  identities     ClubChannelIdentity[]
  consentEvents  ClubConsentEvent[]

  @@index([tierId])
  @@index([firstSource, firstPlatform])
  @@index([referredById])
  @@index([birthMonth, birthDay])
  @@index([lastPurchaseAt])
  @@index([smsConsent])
  @@index([source])
  @@index([sourcePlatform])
  @@index([joinedAt])
  @@index([ownerId, categoryId])
  @@index([categoryId])
}

model ClubTier {
  id        String        @id @default(cuid())
  title     String
  slug      String        @unique
  minSpent  BigInt        @default(0)
  color     String?
  pointRate Float         @default(1)
  benefits  Json          @default("[]")
  sortOrder Int           @default(0)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  profiles  ClubProfile[]

  @@index([isActive])
  @@index([sortOrder])
}

/// تاریخچه‌ی نقاط تماس عضو
///
/// یک ردیف به‌ازای هر بار که عضو از یک منبع دیده شد. بدون این، فقط «اولین» و
/// «آخرین» منبع را می‌دانیم و گزارش مسیر مشتری (باسلام ← سایت ← تلگرام)
/// ممکن نیست.
model ClubTouchpoint {
  id         String       @id @default(cuid())
  profileId  String
  source     ClubSource
  /// کد پلتفرم — "basalam" | "tapsi_shop" | "telegram" | "bale" | ...
  platform   String?
  /// اگر این تماس از یک کانال پیام‌رسان بود
  channel    ClubChannel?
  /// شناسه‌ی عضو در آن پلتفرم (chat_id تلگرام، شناسه‌ی خریدار باسلام و ...)
  externalId String?
  meta       Json?
  occurredAt DateTime     @default(now())

  profile ClubProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, occurredAt])
  @@index([source, platform])
  @@index([occurredAt])
}

/// شناسه‌ی عضو در هر کانال ارتباطی
///
/// برای پیامک شماره‌ی موبایل روی `User` کافی است، ولی تلگرام و بله شناسه‌ی
/// اختصاصی خودشان (chat_id) را دارند که فقط بعد از استارت زدن کاربر به دست
/// می‌آید. بدون این جدول، ارسال چندکاناله ممکن نیست.
model ClubChannelIdentity {
  id           String      @id @default(cuid())
  profileId    String
  channel      ClubChannel
  /// chat_id تلگرام / شناسه‌ی بله / شماره برای SMS
  externalId   String
  /// نام کاربری قابل نمایش در آن پلتفرم
  username     String?
  /// کاربر می‌تواند در همان پلتفرم لغو کند بدون اینکه رکورد حذف شود
  isActive     Boolean     @default(true)
  subscribedAt DateTime    @default(now())
  lastSeenAt   DateTime?
  meta         Json?

  profile ClubProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([channel, externalId])
  @@index([profileId, channel])
  @@index([channel, isActive])
}

/// منبعی که رضایت از آن گرفته شد — برای اثبات در صورت شکایت
enum ConsentSource {
  CHECKOUT // تیک در صفحه تسویه‌حساب
  LANDING // صفحه فرود عمومی / QR فروش حضوری
  SMS_REPLY // پاسخ پیامکی با کلمه کلیدی
  PROFILE // کلید در پنل کاربری خود مشتری
  MESSENGER // /start در ربات بله یا تلگرام
  SELLER // ثبت توسط فروشنده
  ADMIN // تغییر دستی ادمین
  IMPORT // ورود از فایل
}

/// دفتر تاریخچه‌ی رضایت — هر بار دادن یا پس‌گرفتن رضایت یک ردیف
///
/// ⚠️ `ClubProfile.smsConsent` فقط «وضعیت فعلی» است. بدون این دفتر، اگر
///    مشتری شکایت کند هیچ سندی از اینکه کِی و از کجا رضایت داده وجود ندارد.
///    بند ۷ سند باشگاه صراحتاً ثبت تاریخ و IP را لازم می‌داند.
model ClubConsentEvent {
  id        String        @id @default(cuid())
  profileId String
  /// کانالی که رضایت برای آن است — پیامک، بله، تلگرام
  channel   ClubChannel   @default(SMS)
  /// true = رضایت داد، false = لغو کرد
  granted   Boolean
  source    ConsentSource
  ip        String?
  userAgent String?
  note      String?
  createdAt DateTime      @default(now())

  profile ClubProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@index([channel, granted])
  @@index([createdAt])
}

/// متن قالب برای هر کانال
///
/// ⚠️ متن پیامک با متن تلگرام یکی نیست: پیامک کوتاه و بدون قالب‌بندی است،
///    تلگرام Markdown و دکمه دارد. یک متن مشترک یعنی هر دو بد می‌شوند.
///    نبود ردیف برای یک کانال = آن قالب روی آن کانال ارسال نمی‌شود
///    (به‌جز SMS که به `SmsTemplate.body` برمی‌گردد).
model TemplateChannelBody {
  id         String      @id @default(cuid())
  templateId String
  channel    ClubChannel
  body       String
  /// داده‌ی مخصوص کانال — مثل دکمه‌های تلگرام
  extra      Json?
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  template SmsTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, channel])
  @@index([channel])
}

enum CouponType {
  PERCENT // درصدی
  FIXED // مبلغ ثابت
  FREE_SHIP // ارسال رایگان
}

/// کد تخفیف
///
/// جدا از تخفیف محصول (`salePrice`) است: آن روی کالا اعمال می‌شود، این روی
/// سبد. برای هدیه‌ی تولد، بازگرداندن مشتری خوابیده و مزایای سطح لازم است.
model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique
  title         String?
  type          CouponType @default(PERCENT)
  /// درصد (۱ تا ۱۰۰) یا مبلغ ثابت به تومان — بسته به `type`
  value         BigInt     @default(0)
  /// سقف تخفیف برای نوع درصدی — ۰ یعنی بی‌سقف
  maxDiscount   BigInt     @default(0)
  /// حداقل مبلغ سبد برای اعتبار کد
  minOrderTotal BigInt     @default(0)

  startsAt     DateTime?
  expiresAt    DateTime?
  /// سقف کل استفاده — ۰ یعنی نامحدود
  usageLimit   Int       @default(0)
  /// سقف استفاده به‌ازای هر کاربر — ۰ یعنی نامحدود
  perUserLimit Int       @default(1)
  usedCount    Int       @default(0)

  /// اگر پر باشد، فقط همین کاربر می‌تواند استفاده کند (کد اختصاصی تولد و ...)
  userId   String?
  /// اگر پر باشد، فقط اعضای این سطوح
  tierIds  String[] @default([])
  /// فقط اعضایی که رضایت باشگاه دارند
  clubOnly Boolean  @default(false)

  isActive  Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions CouponRedemption[]

  @@index([isActive, expiresAt])
  @@index([userId])
}

/// مصرف یک کد تخفیف روی یک سفارش
///
/// ⚠️ `@@unique([couponId, orderId])` جلوی احتساب دوباره روی یک سفارش را
///    می‌گیرد، و شمارش `perUserLimit` از همین جدول خوانده می‌شود نه از یک
///    شمارنده‌ی جدا که ممکن است ناهمگام شود.
model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String
  /// مبلغ تخفیف واقعی اعمال‌شده (تومان)
  discount  BigInt   @default(0)
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
  @@index([userId])
  @@index([orderId])
}

model PointTransaction {
  id        String      @id @default(cuid())
  profileId String
  amount    Int // مثبت = کسب، منفی = مصرف
  reason    PointReason
  refType   String? // "order" | "campaign" | "instore"
  refId     String?
  note      String?
  expiresAt DateTime?
  createdAt DateTime    @default(now())

  profile ClubProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([reason])
}

enum SmsKind {
  TRANSACTIONAL
  MARKETING
}

enum SmsSendMode {
  PATTERN
  TEXT
}

enum SmsStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

model SmsTemplate {
  id          String      @id @default(cuid())
  key         String      @unique
  title       String
  kind        SmsKind     @default(MARKETING)
  mode        SmsSendMode @default(TEXT)
  patternCode String?
  body        String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  campaigns     SmsCampaign[]
  channelBodies TemplateChannelBody[]
  automations   ClubAutomation[]
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  DONE
  CANCELED
}

model SmsCampaign {
  id            String         @id @default(cuid())
  title         String
  templateId    String
  segment       Json           @default("{}")
  status        CampaignStatus @default(DRAFT)
  scheduledAt   DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  totalCount    Int            @default(0)
  sentCount     Int            @default(0)
  failedCount   Int            @default(0)
  skippedCount  Int            @default(0)
  estimatedCost BigInt         @default(0)
  createdById   String?
  createdAt     DateTime       @default(now())

  template SmsTemplate  @relation(fields: [templateId], references: [id])
  messages SmsMessage[]

  @@index([status])
  @@index([scheduledAt])
}

model SmsMessage {
  id                String      @id @default(cuid())
  userId            String?
  phone             String
  campaignId        String?
  automationId      String?
  templateKey       String?
  kind              SmsKind     @default(MARKETING)
  /// کانالی که پیام از آن رفت. پیش‌فرض SMS تا ردیف‌های موجود معنا داشته باشند.
  channel           ClubChannel @default(SMS)
  /// شناسه‌ی گیرنده در آن کانال — برای SMS همان `phone` است
  destination       String?
  body              String?
  lineNumber        String?
  provider          String      @default("iranpayamak")
  providerRequestId Int?
  status            SmsStatus   @default(QUEUED)
  skipReason        String?
  errorMessage      String?
  cost              BigInt      @default(0)
  queuedAt          DateTime    @default(now())
  sentAt            DateTime?
  deliveredAt       DateTime?
  providerStatus    String?

  campaign SmsCampaign? @relation(fields: [campaignId], references: [id])

  @@index([userId])
  @@index([phone])
  @@index([status])
  @@index([campaignId])
  @@index([providerRequestId])
  @@index([queuedAt])
  @@index([channel, status])
}

model SmsOptOut {
  id        String   @id @default(cuid())
  phone     String   @unique
  reason    String?
  source    String? // "sms_reply" | "blacklist" | "admin" | "panel"
  createdAt DateTime @default(now())
}

enum ClubTrigger {
  WELCOME
  BIRTHDAY
  MEMBERSHIP_ANNIVERSARY
  AFTER_PURCHASE
  PURCHASE_FEEDBACK
  DORMANT_CUSTOMER
  TIER_UPGRADE
  POINTS_EXPIRING
}

model ClubAutomation {
  id           String      @id @default(cuid())
  trigger      ClubTrigger @unique
  templateId   String
  delayMinutes Int         @default(0)
  conditions   Json        @default("{}")
  sendHour     Int         @default(10)
  isActive     Boolean     @default(false)
  lastRunAt    DateTime?

  template SmsTemplate @relation(fields: [templateId], references: [id])
}

model LandingPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  categoryId  String
  /// { "print-type": "laser", "usage-type": "single-function", "brand": "hp" }
  filters     Json
  title       String
  h1          String
  description String
  intro       String?
  bodyHtml    String?
  isActive    Boolean  @default(true)
  isIndexable Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([isActive, isIndexable])
}

enum RedirectMatch {
  EXACT // /old/path            — کل مسیر برابر باشد
  PREFIX // /old/*               — مسیر با این شروع شود، دنباله به مقصد چسبانده می‌شود
  REGEX // ^/product/(\d+)$     — با $1 … در مقصد
}

/// ریدایرکت‌های قابل مدیریت از پنل ادمین.
///
/// `source` همیشه به شکل نرمال‌شده ذخیره می‌شود: با `/` شروع، بدون دامنه،
/// بدون query string و بدون `/` انتهایی (به‌جز خود ریشه). نرمال‌سازی در
/// `lib/redirects.ts` انجام می‌شود تا ادمین و middleware هر دو یک قاعده داشته باشند.
///
/// برای مهاجرت‌های بزرگ (چند هزار ریدایرکت) هنوز nginx گزینه‌ی بهتری است؛
/// این جدول برای ریدایرکت‌های جاری و روزمره است.
model Redirect {
  id          String        @id @default(cuid())
  source      String        @unique
  destination String
  statusCode  Int           @default(301) // 301 | 302 | 307 | 308 | 410
  matchType   RedirectMatch @default(EXACT)
  isActive    Boolean       @default(true)
  hits        Int           @default(0)
  lastHitAt   DateTime?
  note        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([isActive, matchType])
  @@index([hits])
}

/// آدرس‌هایی که ۴۰۴ گرفته‌اند، برای اینکه ادمین از روی داده‌ی واقعی
/// ریدایرکت بسازد نه حدس. `path` نرمال‌شده ذخیره می‌شود.
model NotFoundLog {
  id        String   @id @default(cuid())
  path      String   @unique
  hits      Int      @default(1)
  referer   String?
  userAgent String?
  firstSeen DateTime @default(now())
  lastSeen  DateTime @updatedAt
  ignored   Boolean  @default(false)

  @@index([ignored, hits])
  @@index([lastSeen])
}

/// برگه‌های ثابت سایت (تماس با ما، درباره ما، قوانین، سوالات متداول، ...)
/// نشانی برگه در ریشه‌ی سایت است: /{slug}
model Page {
  id             String       @id @default(cuid())
  slug           String       @unique
  title          String
  subtitle       String?
  template       PageTemplate @default(DEFAULT)
  contentHtml    String?
  coverImage     String?
  /// بلوک‌های اختیاری بسته به قالب:
  /// { contact:{phone,mobile,email,address,postalCode,workHours,mapEmbed,socials:[{label,url}]},
  ///   faq:[{q,a}], stats:[{value,label}], features:[{icon,title,text}], updatedLabel }
  blocks         Json?
  seoTitle       String?
  seoDescription String?
  isActive       Boolean      @default(true)
  isIndexable    Boolean      @default(true)
  showToc        Boolean      @default(false)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([isActive, sortOrder])
}

enum PageTemplate {
  DEFAULT /// برگه‌ی ساده: عنوان + متن
  ABOUT /// درباره ما: آمار + ویژگی‌ها
  CONTACT /// تماس با ما: کارت‌های تماس + نقشه
  FAQ /// سوالات متداول: آکاردئون + اسکیمای FAQPage
  LEGAL /// قوانین/حریم خصوصی: فهرست مطالب چسبان
}

/// ─── گزارش عملکرد ادمین ────────────────────────────────────────────────────
/// هر تغییری که یک ادمین در پنل انجام می‌دهد اینجا ثبت می‌شود تا بعداً
/// قابل استناد باشد: «محصول را گذاشتم و نیست» یا «عکس را عوض کردم» با
/// همین جدول قابل راستی‌آزمایی است.
///
/// نام و شماره‌ی ادمین **در لحظه‌ی ثبت** کپی می‌شوند تا اگر بعداً حساب حذف
/// یا تغییر نام داد، گزارش‌های قدیمی همچنان خوانا بمانند.
model ActivityLog {
  id          String         @id @default(cuid())
  actorId     String?
  actorName   String
  actorPhone  String?
  action      ActivityAction
  entity      ActivityEntity
  entityId    String?
  entityTitle String?
  /// خلاصه‌ی یک‌خطی و خوانا برای نمایش در فهرست
  summary     String?
  /// آرایه‌ی تغییرات: [{ field, label, before, after }]
  changes     Json?
  ip          String?
  createdAt   DateTime       @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  BULK_UPDATE
  UPLOAD
  LOGIN
}

enum ActivityEntity {
  PRODUCT
  CATEGORY
  BRAND
  MEDIA
  WIDGET
  PAGE
  ORDER
  STORY
  HERO_SLIDE
  BLOG
  USER
  SETTINGS
  STAFF_ROLE
  STAFF_TASK
  SEO_TASK
  CONTENT_TASK
  LINK_NODE
  OTHER
}

// ═══════════════════════════════════════════════════════════════════
// کارتابل — مدیریت کار و عملکرد کارکنان
// مستندات: docs/features/staff-worklist.md
// ═══════════════════════════════════════════════════════════════════

/// دامنه‌ی کار — enum ثابت در کد چون واحد گروه‌بندی گزارش‌هاست.
/// نوعِ کار برعکس، جدول است تا مدیر بتواند بدون مهاجرت اضافه کند.
enum StaffDomain {
  SALES // فروش
  FINANCE // مالی و پرداخت
  PROCUREMENT // تأمین و خرید
  FULFILLMENT // ارسال و تحویل
  CATALOG // کاتالوگ و قیمت
  CONTENT // محتوا و بازاریابی
  SUPPORT // پشتیبانی و گارانتی
  INTERNAL // داخلی و اداری
}

enum StaffChannel {
  NONE
  CALL_IN
  CALL_OUT
  SMS
  MESSENGER
  EMAIL
  IN_PERSON
  ONLINE
}

/// از کجا این ردیف کار به وجود آمد
enum StaffTaskSource {
  MANUAL // کارمند خودش ثبت کرد
  RECURRING // قاعده‌ی تکرارشونده ساخت
  ASSIGNED // مدیر یا همکار ارجاع داد
  SYSTEM // از یک نوشتنِ واقعی در پنل استخراج می‌شود
}

/// نقش کارتابل — لایه‌ای جدا از UserRole.
///
/// ⚠️ `UserRole` عمداً دست‌نخورده می‌ماند: ۴۶ جای کد مستقیم "ADMIN" را چک
/// می‌کند و افزودن عضو تازه یعنی ریسک باز شدن مسیر ادمین. کاربری که
/// `staffRoleId` ندارد دسترسی کامل دارد، پس روز دیپلوی هیچ‌کس بیرون نمی‌افتد.
model StaffRole {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  /// کلیدهای مجوز — تعریف کلیدها در lib/permissions.ts است، ترکیبشان اینجا.
  /// مجوزی که هیچ کدی چکش نمی‌کند فقط توهم امنیت می‌سازد، پس ساخت کلید تازه
  /// از پنل ممکن نیست.
  permissions String[] @default([])
  /// نقش سیستمی حذف نمی‌شود و مجوزهایش کم نمی‌شود
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@index([isActive, sortOrder])
}

/// نوع کار — قابل افزودن توسط مدیر بدون تغییر کد.
///
/// ⚠️ هرگز حذف نمی‌شود، فقط `isActive = false` می‌گیرد. کارهای ثبت‌شده به آن
/// ارجاع دارند و حذفش گزارش‌های سال قبل را می‌شکند.
model StaffTaskType {
  id               String          @id @default(cuid())
  slug             String          @unique
  title            String
  domain           StaffDomain
  channel          StaffChannel    @default(NONE)
  source           StaffTaskSource @default(MANUAL)
  /// وقتی source = SYSTEM: کلید نگاشت به ActivityLog — lib/worklist/system-map.ts
  systemKey        String?         @unique
  icon             String?
  color            String?
  /// نتیجه‌های آماده: [{ value, label, isSuccess }]
  /// ⚠️ نتیجه دکمه است نه فیلد متنی؛ متن آزاد یعنی نمودار هرگز ساخته نمی‌شود.
  outcomes         Json            @default("[]")
  needsCustomer    Boolean         @default(false)
  needsAmount      Boolean         @default(false)
  needsLink        Boolean         @default(false)
  /// باربری از `ShippingMethod` های `useInWorklist` انتخاب می‌شود
  needsCarrier     Boolean         @default(false)
  /// شماره‌ی مرجع لازم دارد؟ برچسبش در `refLabel` — شماره فاکتور رسمی،
  /// شماره مرسوله، کد پیگیری تعمیر. عمداً عمومی است نه فیلد فاکتور.
  needsRef         Boolean         @default(false)
  /// برچسب فیلد مرجع. خالی یعنی «شماره مرجع»
  refLabel         String?
  /// انتخاب بازارگاه لازم دارد؟ فهرست از `StoreSettings.worklistPlatforms`.
  /// ⚠️ پلتفرم **بُعد گزارش** است نه نتیجه — بخش ۴ سند تنظیم‌پذیری.
  needsPlatform    Boolean         @default(false)
  /// بستن موفقِ این کار یک معامله‌ی دستی از روی `amount` می‌سازد — تعمیرات
  createsDeal      Boolean         @default(false)
  /// معامله‌ی ساخته‌شده در سود می‌آید ولی پورسانت نمی‌سازد
  dealNoCommission Boolean         @default(false)
  /// مهلت خودکار بر حسب دقیقه از لحظه‌ی ساخت — پیک تهران ۱۲۰، شهرستان ۱۴۴۰
  slaMinutes       Int?
  /// وزن این نوع در امتیازدهی — فاز ۶
  weight           Float           @default(1)
  isActive         Boolean         @default(true)
  sortOrder        Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  tasks StaffTask[]
  rules StaffRecurringRule[]

  @@index([domain, isActive])
  @@index([source])
  @@index([isActive, sortOrder])
}

enum StaffTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELED
}

enum StaffPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// یک واحد کار — چه انجام‌شده چه در انتظار.
///
/// «کار» و «فعالیت انجام‌شده» عمداً یک مدل‌اند: کارِ باز همان فرمِ نیمه‌پرشده
/// است و کارمند فقط می‌بنددش. تماس هم موجودیت جدا نیست، فقط `channel` دارد.
///
/// ⚠️ تغییر وضعیت فقط از `lib/worklist/task-service.ts` انجام می‌شود.
model StaffTask {
  id      String          @id @default(cuid())
  typeId  String
  /// کپی از نوع — تا تغییر بعدیِ نوع، گزارش پارسال را جابه‌جا نکند
  domain  StaffDomain
  channel StaffChannel    @default(NONE)
  source  StaffTaskSource @default(MANUAL)
  title   String

  /// کارمند مسئولِ فعلی — نام اسنپ‌شات است نه رابطه، مثل ActivityLog،
  /// تا حذف یا تغییر نام حساب گزارش‌های قدیمی را نشکند
  ownerId       String?
  ownerName     String
  createdById   String?
  createdByName String

  status   StaffTaskStatus @default(OPEN)
  priority StaffPriority   @default(NORMAL)

  /// طرف مقابل — عضو باشگاه، یا فقط یک شماره، یا یک تأمین‌کننده.
  /// رابطه‌ی واقعی است تا پرونده‌ی مشتری و محافظِ فاصله‌ی قواعد تکرارشونده
  /// بدون کوئری دستی کار کنند. حذف کاربر فقط این فیلد را خالی می‌کند.
  customerId   String?
  customer     User?          @relation("StaffTaskCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  contactName  String?
  contactPhone String?
  supplierName String?
  /// از فهرست تأمین‌کننده‌ها — `supplierName` اسنپ‌شات نام همان است (تله‌ی ۴)
  supplierId   String?
  supplier     StaffSupplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  /// اتصال به موجودیت فروشگاه — از همان ActivityEntity استفاده می‌شود
  entity   ActivityEntity?
  entityId String?
  linkUrl  String?
  amount   BigInt?
  carrier  String?
  /// شماره‌ی مرجع — برچسبش از `StaffTaskType.refLabel` می‌آید
  refNo    String?
  /// بازارگاه — **نام اسنپ‌شات**، مثل `carrier` و `supplierName`. فهرستِ
  /// انتخاب از `StoreSettings.worklistPlatforms` می‌آید ولی آنچه ذخیره
  /// می‌شود نام است، تا تغییر بعدیِ فهرست گزارش پارسال را خالی نکند.
  platform String?

  /// یکی از مقادیر `outcomes` نوع کار — دکمه است نه متن آزاد
  outcome String?
  note    String?

  /// کار فرزند: تماس فروشی که به کار خرید منجر شد
  parentId String?
  /// قاعده‌ی تکرارشونده‌ای که این ردیف را ساخت
  ruleId   String?
  /// کلید یکتاییِ ساخت خودکار — `ruleId:روز` یا `ruleId:مشتری:روز`.
  /// ⚠️ ایندکس یکتا تنها چیزی است که جلوی دوباره‌ساخته‌شدن را حتی در اجرای
  /// هم‌زمان می‌گیرد. شرط `findFirst` قبل از `create` کافی نیست.
  runKey   String? @unique

  dueAt      DateTime?
  /// کِی اتفاق افتاد — قابل عقب‌بردن توسط کارمند
  occurredAt DateTime?
  doneAt     DateTime?
  /// کِی در سیستم ثبت شد — ⚠️ مبنای همه‌ی آمار عملکرد همین است، نه occurredAt.
  /// کارِ دیروز که امروز ثبت شده، کارِ امروز است.
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  type      StaffTaskType       @relation(fields: [typeId], references: [id])
  parent    StaffTask?          @relation("StaffTaskChildren", fields: [parentId], references: [id])
  children  StaffTask[]         @relation("StaffTaskChildren")
  notes     StaffTaskNote[]
  referrals StaffTaskReferral[]
  /// معامله‌ای که از بستن موفق این کار ساخته شد — فقط برای نوع‌های `createsDeal`
  deal      StaffDeal?

  @@index([ownerId, status, dueAt])
  @@index([status, dueAt])
  @@index([createdAt])
  @@index([domain, createdAt])
  @@index([typeId, createdAt])
  @@index([customerId, createdAt])
  @@index([entity, entityId])
  @@index([contactPhone])
  @@index([parentId])
  @@index([supplierId])
  /// گزارش «هر بازارگاه چند روز از سی روز بروز شد»
  @@index([platform, occurredAt])
}

/// رشته‌ی یادداشت‌های یک کار.
///
/// یادداشت‌گذاشتن کار را `IN_PROGRESS` می‌کند. نویسنده‌ی یادداشت لزوماً
/// مسئولِ کار نیست — خیلی وقت‌ها یکی کار را انجام می‌دهد و دیگری مستندش می‌کند.
model StaffTaskNote {
  id         String    @id @default(cuid())
  taskId     String
  authorId   String?
  authorName String
  body       String
  createdAt  DateTime  @default(now())
  editedAt   DateTime?

  task StaffTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([authorId, createdAt])
}

/// تاریخچه‌ی دست‌به‌دست شدن یک کار.
///
/// جدول جداست نه یک ستون، چون یک کار ممکن است چند بار ارجاع شود
/// («علیزاده به صادقی به امیری») و تاریخچه باید کنار یادداشت‌ها دیده شود.
/// `StaffTask.ownerId` فقط **آخرین** گیرنده است؛ ردیف‌های قبلی سر جایشان می‌مانند.
///
/// ⚠️ `isUrgent` خصیصه‌ی **ارجاع** است نه کار: یک ارجاع می‌تواند فوری باشد و
/// ارجاع بعدیِ همان کار عادی. اولویت کار (`StaffTask.priority`) چیز دیگری است.
model StaffTaskReferral {
  id        String    @id @default(cuid())
  taskId    String
  fromId    String?
  fromName  String
  toId      String
  toName    String
  note      String?
  /// فوری = پاپ‌آپ برای گیرنده
  isUrgent  Boolean   @default(false)
  /// ⚠️ وقتی گیرنده عملاً ردیف را **باز کند** پر می‌شود، نه وقتی فهرست رندر
  /// شود. اگر موقع رندر علامت بزنیم، اولین refetch نشان را پیش از دیده‌شدن
  /// پاک می‌کند — این اشتباه یک بار در برتر انجام شد و در تست گرفته شد.
  seenAt    DateTime?
  createdAt DateTime  @default(now())

  task StaffTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([toId, seenAt])
  @@index([toId, createdAt])
  @@index([taskId, createdAt])
}

enum StaffScheduleKind {
  DAILY // هر روز کاری
  WEEKLY // روزهای مشخصی از هفته
  MONTHLY // روز مشخصی از ماه
  CUSTOMER_IDLE // به‌ازای هر مشتری که N روز از آخرین خریدش گذشته
}

/// قاعده‌ی ساخت خودکار کار.
///
/// این قلبِ «کارشان راحت‌تر شود» است: کارمند برای کار تکراری هیچ‌وقت رکورد
/// نمی‌سازد، فقط رکوردِ از پیش ساخته‌شده را می‌بندد. ردیفِ باز خودش فرمِ
/// نیمه‌پرشده است.
///
/// ⚠️ سه محافظ اجباری‌اند و بدون هرکدام این قابلیت به فاجعه تبدیل می‌شود:
/// یکتایی (`StaffTask.runKey`)، سقف (`maxPerRun`) و فاصله (`idleDays`).
model StaffRecurringRule {
  id           String            @id @default(cuid())
  typeId       String
  title        String
  /// کارمند ثابتِ این قاعده — `null` یعنی بین اعضای نقش نوبتی توزیع می‌شود
  ownerId      String?
  ownerName    String?
  /// وقتی `ownerId` خالی است: بین دارندگان این نقش گردشی
  roleId       String?
  schedule     StaffScheduleKind
  /// برای WEEKLY — شنبه = ۰، مطابق تقویم ایران
  daysOfWeek   Int[]             @default([])
  /// برای MONTHLY — روز ماه شمسی
  dayOfMonth   Int?
  /// "09:00" — فقط ترتیب نمایش در کارتابل، نه زمان دقیق اجرا
  timeOfDay    String?
  /// برای CUSTOMER_IDLE: چند روز از آخرین خرید گذشته باشد.
  /// همین عدد **فاصله‌ی محافظ** هم هست: مشتری‌ای که در این بازه با او تماس
  /// گرفته شده دوباره انتخاب نمی‌شود.
  idleDays     Int?
  /// شرط اضافه‌ی انتخاب مشتری — رزرو برای اتصال به سگمنت باشگاه
  segmentJson  Json?
  /// سقف ردیف در هر اجرا. اولین اجرای «مشتریان بیش از نود روز» هزاران نفر
  /// واجد شرایط دارد؛ بدون سقف کارتابل یک نفر پر می‌شود و دیگر بازش نمی‌کند.
  maxPerRun    Int               @default(20)
  isActive     Boolean           @default(true)
  lastRunAt    DateTime?
  /// تعداد کارِ ساخته‌شده در آخرین اجرا — برای صفحه‌ی تنظیمات
  lastRunCount Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  type StaffTaskType @relation(fields: [typeId], references: [id])

  @@index([isActive, schedule])
}

// ═══════════════════════════════════════════════════════════════════
// کارتابل — فاز ۵: حضور و ساعت کاری
// مستندات: docs/features/staff-worklist.md بخش ۱۱
// ═══════════════════════════════════════════════════════════════════

/// چرا نشست بسته شد
enum StaffSessionEnd {
  LOGOUT // خودش خروج زد
  TIMEOUT // ضربان قطع شد و سیستم بست
  MANUAL // مدیر دستی اصلاح کرد
}

/// نشستِ خام — هرگز پاک یا اصلاح نمی‌شود.
///
/// ⚠️ خام جدا از تجمیع‌شده نگه داشته می‌شود. وقتی داده‌ی یک ماه مشکوک به نظر
/// می‌رسد، تنها راه بررسی این است که به رکورد خام برگردیم. اگر فقط
/// `StaffWorkDay` بماند و مدیر اصلاحش کند، دیگر راهی برای فهمیدن واقعیت نیست.
model StaffWorkSession {
  id         String           @id @default(cuid())
  userId     String
  startedAt  DateTime         @default(now())
  lastSeenAt DateTime         @default(now())
  endedAt    DateTime?
  endReason  StaffSessionEnd?
  ip         String?
  userAgent  String?

  @@index([userId, startedAt])
  @@index([endedAt])
}

/// روزِ تجمیع‌شده — قابل اصلاح دستی توسط مدیر.
///
/// ⚠️ `activeMin` از **ادغام** بازه‌های هم‌پوشان می‌آید نه جمعشان. دو تب باز
/// یعنی دو نشستِ هم‌زمان؛ جمع‌زدنشان ساعت حضور را دو برابر می‌کند.
///
/// ⚠️ ردیفی که `editedById` دارد دیگر بازسازی نمی‌شود. اصلاح مدیر حرف آخر است
/// تا چرخه‌ی بعدیِ زمان‌بند بی‌صدا رویش ننویسد.
model StaffWorkDay {
  id           String    @id @default(cuid())
  userId       String
  /// نیمه‌شب روز شمسی به وقت تهران — مرز ماه از lib/club/jalali.ts می‌آید
  day          DateTime  @db.Date
  firstIn      DateTime
  lastOut      DateTime
  /// دقیقه‌ی حضور مؤثر: مجموع بازه‌های ادغام‌شده، بعد از اعمال سقف روزانه
  activeMin    Int
  /// دقیقه‌ی خام از اولین ورود تا آخرین خروج، بدون کسر فاصله‌ها
  grossMin     Int
  note         String?
  editedById   String?
  editedByName String?
  editedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, day])
  @@index([day])
}

/// یادداشت شخصی کارمند در کارتابل — مثل Google Keep.
///
/// ⚠️ کاملاً خصوصی است: هیچ مجوزی (حتی دسترسی کامل ادمین) دیدن یادداشت
/// دیگری را باز نمی‌کند. همه‌ی کوئری‌ها باید با `userId` کاربر جاری فیلتر شوند.
model StaffNote {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("")
  body      String   @default("")
  /// کلید رنگ — فهرست مجاز در lib/worklist/note-colors.ts
  color     String   @default("default")
  pinned    Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, archived, pinned, updatedAt])
}

// ═══════════════════════════════════════════════════════════════════
// کارتابل — تأمین‌کننده، مالکیت مشتری
// مستندات: docs/features/staff-worklist.md بخش‌های ۱۹ و ۲۱
// ═══════════════════════════════════════════════════════════════════

enum StaffWorkMode {
  ONSITE // حضوری
  REMOTE // دورکار
  HYBRID // ترکیبی
}

/// تأمین‌کننده — فهرست مشترک برای کار، معامله و گزارش.
///
/// ⚠️ حذف نمی‌شود، فقط `isActive = false`؛ کارها و معامله‌های قدیمی به آن ارجاع دارند.
model StaffSupplier {
  id            String   @id @default(cuid())
  name          String
  /// نام نرمال‌شده برای جلوگیری از تکرار («شرکت الف» و «شركت الف» یکی‌اند)
  nameKey       String   @unique
  contactName   String?
  phone         String?
  city          String?
  note          String?
  isActive      Boolean  @default(true)
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tasks StaffTask[]
  deals StaffDeal[]

  @@index([isActive, name])
}

/// دسته‌ی مشتری — ارگانی، تهران، شهرستان… قابل افزودن توسط مدیر.
///
/// با سطح باشگاه (`ClubTier`) قاطی نمی‌شود: سطح با خرید به دست می‌آید، دسته را
/// آدم تعیین می‌کند. ⚠️ حذف نمی‌شود، فقط `isActive = false`.
model ClubCustomerCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  color     String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles ClubProfile[]

  @@index([isActive, sortOrder])
}

enum StaffClaimSource {
  MANUAL // کارمند خودش ثبت کرد
  CALL // نتیجه‌ی تماس ثبت شد و مشتری بی‌صاحب بود
  ORDER // سفارش تلفنی به نامش ثبت شد
  ADMIN // مدیر تخصیص داد
}

/// تاریخچه‌ی جابه‌جایی مالکیت مشتری — هرگز پاک نمی‌شود.
model ClubOwnerTransfer {
  id        String           @id @default(cuid())
  profileId String
  fromId    String?
  fromName  String?
  /// خالی یعنی مشتری بی‌صاحب شد
  toId      String?
  toName    String?
  byId      String?
  byName    String
  via       StaffClaimSource
  reason    String?
  createdAt DateTime         @default(now())

  profile ClubProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
}

// ═══════════════════════════════════════════════════════════════════
// کارتابل فاز ۹ — سود مستقیم و پورسانت
// مستندات: docs/features/staff-worklist.md بخش ۲۲
// ═══════════════════════════════════════════════════════════════════

enum ProductCondition {
  NEW // نو
  STOCK // استوک
  USED // دست‌دوم
  REFURBISHED // بازسازی‌شده
}

enum StaffDealStatus {
  PENDING // درآمد معلوم است، هزینه هنوز وارد نشده
  CONFIRMED // هزینه وارد شده، سود و پورسانت قطعی است
  VOID // سفارش لغو یا مرجوع شد
}

/// یک معامله‌ی سوددار که به یک کارمند نسبت داده می‌شود.
///
/// ⚠️ `orderId` یکتاست: هر سفارش حداکثر یک ردیف سود دارد.
/// ⚠️ دوره‌ی باز جدول ندارد: هر معامله‌ی CONFIRMED با `payoutId = null` در دوره‌ی باز است.
model StaffDeal {
  id               String          @id @default(cuid())
  orderId          String?         @unique
  customerId       String?
  /// خالی = بی‌صاحب؛ هیچ‌وقت پورسانت نمی‌سازد تا مدیر تخصیص دهد
  ownerId          String?
  ownerName        String?
  customerName     String?
  title            String
  /// مبلغ کالاها بعد از تخفیف، بدون کرایه‌ی ارسال
  revenue          BigInt          @default(0)
  cost             BigInt?
  profit           BigInt?
  commission       BigInt?
  costPerItem      Boolean         @default(false)
  /// فروش ریفری — از `Order.isReferral` کپی می‌شود؛ قاعده‌های `referral` طرح را می‌گیرد
  isReferral       Boolean         @default(false)
  /// معامله‌ی بدون سفارش — درآمدش را کارمند وارد کرده
  isManual         Boolean         @default(false)
  /// در سود می‌آید ولی پورسانت نمی‌سازد — مثل درآمد تعمیرات.
  /// روی معامله است نه نوع کار، تا مدیر بتواند یک مورد را استثنا کند.
  noCommission     Boolean         @default(false)
  /// کارِ کارتابلی که این معامله را ساخت — مرز «هر کار حداکثر یک معامله»
  taskId           String?         @unique
  supplierId       String?
  supplierName     String?
  note             String?
  status           StaffDealStatus @default(PENDING)
  /// «1405-06» — فقط برای گزارش ماهانه، ربطی به دوره‌ی پرداخت ندارد
  monthKey         String
  occurredAt       DateTime
  confirmedAt      DateTime?
  confirmedById    String?
  confirmedByName  String?
  /// تسویه‌ای که این معامله را پوشش داد
  payoutId         String?
  /// معامله‌ای که بعد از پرداخت VOID شد، کسری‌اش در این تسویه آمد
  adjustedPayoutId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  order          Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customer       User?           @relation("StaffDealCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  owner          User?           @relation("StaffDealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  supplier       StaffSupplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  task           StaffTask?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  payout         StaffPayout?    @relation("StaffPayoutDeals", fields: [payoutId], references: [id])
  adjustedPayout StaffPayout?    @relation("StaffPayoutAdjustments", fields: [adjustedPayoutId], references: [id])
  items          StaffDealItem[]

  @@index([ownerId, payoutId, status])
  @@index([ownerId, monthKey])
  @@index([payoutId, status])
  @@index([status, createdAt])
}

/// یک ردیف معامله به‌ازای هر کالای سفارش — چون درصد پورسانت به کالا بستگی دارد.
/// دسته و وضعیت کالا در لحظه‌ی ساخت کپی می‌شوند.
model StaffDealItem {
  id           String           @id @default(cuid())
  dealId       String
  orderItemId  String?          @unique
  productId    String?
  title        String
  categoryId   String?
  /// زنجیره‌ی دسته از خودش تا ریشه — تطبیق قاعده بدون پیمایش درخت
  categoryPath String[]         @default([])
  condition    ProductCondition @default(NEW)
  qty          Int              @default(1)
  revenue      BigInt           @default(0)
  cost         BigInt?
  profit       BigInt?
  percent      Float?
  commission   BigInt?
  ruleId       String?
  ruleLabel    String?

  deal StaffDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([categoryId])
}

model StaffCommissionPlan {
  id        String   @id @default(cuid())
  title     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rules StaffCommissionRule[]
  users User[]
}

/// قاعده‌ی درصد. قاعده‌ی بدون دسته و بدون وضعیت، پیش‌فرض همه‌ی کالاهاست.
model StaffCommissionRule {
  id         String            @id @default(cuid())
  planId     String
  categoryId String?
  condition  ProductCondition?
  /// فقط فروش ریفری را می‌گیرد و بر هر قاعده‌ی غیرریفری برنده است (بخش ۲۲.۱۰).
  /// `false` یعنی «هر فروشی» — قاعده‌های قبلی همان رفتار را نگه می‌دارند.
  referral   Boolean           @default(false)
  percent    Float
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())

  plan     StaffCommissionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  category Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([planId, isActive])
}

/// یک تسویه‌ی ثبت‌شده با یک کارمند — از لحظه‌ی ساخت قفل است.
///
/// پرداخت جزئی مجاز است (بخش ۱۹، سؤال ۱۰): `due` مبلغ قابل پرداخت، `amount`
/// آنچه واقعاً پرداخت شد، و `remaining` به تسویه‌ی بعدی منتقل می‌شود.
model StaffPayout {
  id              String   @id @default(cuid())
  userId          String
  userName        String
  fromAt          DateTime
  toAt            DateTime
  dealCount       Int      @default(0)
  totalProfit     BigInt   @default(0)
  grossCommission BigInt   @default(0)
  /// فقط نمایشی: grossCommission ÷ totalProfit
  percent         Float    @default(0)
  planTitle       String?
  /// کسری مرجوعی‌های بعد از پرداخت — منفی یا صفر
  adjustment      BigInt   @default(0)
  /// باقی‌مانده‌ی تسویه‌ی قبلی که به این دوره آمد
  carriedIn       BigInt   @default(0)
  /// grossCommission + adjustment + carriedIn
  due             BigInt   @default(0)
  amount          BigInt   @default(0)
  /// due - amount → carriedIn تسویه‌ی بعدی
  remaining       BigInt   @default(0)
  paidAt          DateTime @default(now())
  paidById        String?
  paidByName      String
  note            String?

  user        User        @relation("StaffPayoutUser", fields: [userId], references: [id])
  deals       StaffDeal[] @relation("StaffPayoutDeals")
  adjustments StaffDeal[] @relation("StaffPayoutAdjustments")

  @@index([userId, paidAt])
  @@index([paidAt])
}

// ═══════════════════════════════════════════════════════════════════
// سئو، محتوا و لینک‌سازی — زیرمجموعه‌ی کارتابل
// مستندات: docs/plans/seo-marketing.md
//
// ⚠️ سه قاعده‌ی مشترک هر سه حوزه:
//   ۱. هر انتقال وضعیت فقط از سرویس خودش عبور می‌کند و سه کار می‌کند:
//      وضعیت را عوض می‌کند، یک رویداد می‌سازد، به نفر بعدی اعلان می‌دهد.
//   ۲. حذف همه‌جا نرم است (`deletedAt`) و رویدادها می‌مانند.
//   ۳. کنار هر شناسه‌ی کاربر، اسنپ‌شات نام می‌نشیند — حساب حذف‌شده نباید
//      گزارش پارسال را خالی کند. (همان قرارداد StaffTask و ActivityLog)
// ═══════════════════════════════════════════════════════════════════

/// عملِ ثبت‌شده روی یک رویداد. بین هر سه حوزه مشترک است تا نگاشت فارسی
/// یکی بماند؛ هر حوزه زیرمجموعه‌ی خودش را به کار می‌برد.
enum MarketingEventAction {
  CREATED
  ASSIGNED // مسئول عوض شد
  STARTED
  REPORTED // گزارش انجام / ارسال به محتواگذار
  PUBLISHING // محتواگذار کار را دست گرفت
  SUBMITTED // تکمیل / ثبت آدرس لینک
  APPROVED
  RETURNED // برگشت با دلیل
  CANCELED
  REOPENED
  FAILED // گره نشد
  LOST // لینک بود و دیگر نیست
  REVIEWED // نتیجه‌ی بررسی ثبت شد
  SYSTEM // ساخت از الگو، یادآوری، هشدار زمان‌بند — actorId خالی
}

// ───────────────────────────── کارهای سئو ─────────────────────────────

enum SeoTaskStatus {
  ASSIGNED
  IN_PROGRESS
  AWAITING_APPROVAL
  DONE
  CANCELED
}

/// نتیجه‌ی بررسیِ بعد از انجام. وضعیت کار را عوض **نمی‌کند**: کار انجام شده،
/// سؤال این است که ارزشش را داشت یا نه.
enum SeoReviewOutcome {
  EFFECTIVE // اثر داشت
  PARTIAL // اثر جزئی
  INEFFECTIVE // اثر نداشت
}

enum SeoRecurrenceUnit {
  WEEK
  MONTH // ماهِ **شمسی** — lib/marketing/seo-recurrence.ts
}

/// دسته‌ی کار سئو — جدول است نه enum تا مدیر بدون مهاجرت اضافه کند.
/// دسته‌ی سیدشده `key` دارد که گزارش‌های فاز آنالیز رویش می‌نشینند، پس
/// حذف نمی‌شود؛ فقط `isActive = false`.
model SeoTaskCategory {
  id          String   @id @default(cuid())
  key         String?  @unique
  title       String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks      SeoTask[]
  recurrings SeoRecurringTask[]

  @@index([isActive, sortOrder])
}

model SeoTask {
  id          String  @id @default(cuid())
  /// شماره‌ی نمایشی برای گفت‌وگوی روزمره: «کار سئو ۱۲»
  code        Int     @default(autoincrement())
  categoryId  String
  title       String
  description String?
  /// آدرس صفحه‌های مربوط — هر خط یک آدرس. عمداً متن است نه جدول؛ فعلاً فقط
  /// نمایش و جست‌وجو دارد. مبنای «یادداشت تغییر» روی نمودار فاز آنالیز.
  pageUrls    String?

  assigneeId    String?
  assigneeName  String
  createdById   String?
  createdByName String

  status   SeoTaskStatus @default(ASSIGNED)
  priority StaffPriority @default(NORMAL)
  dueAt    DateTime?

  /// گزارش انجام — اجباری هنگام رفتن به AWAITING_APPROVAL
  report         String?
  returnReason   String?
  cancelReason   String?
  startedAt      DateTime?
  reportedAt     DateTime?
  approvedAt     DateTime?
  approvedById   String?
  approvedByName String?

  /// بررسی نتیجه (بخش ۵.۵ مستندات)
  reviewAt         DateTime?
  reviewOutcome    SeoReviewOutcome?
  reviewNote       String?
  reviewedAt       DateTime?
  /// جلوی یادآوری تکراری را می‌گیرد؛ قبضه‌ی اتمیک زمان‌بند رویش می‌نشیند
  reviewRemindedAt DateTime?

  /// الگویی که این ردیف را ساخت
  recurrenceId String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  category   SeoTaskCategory        @relation(fields: [categoryId], references: [id])
  recurrence SeoRecurringTask?      @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  checklist  SeoTaskChecklistItem[]
  files      SeoTaskFile[]
  events     SeoTaskEvent[]

  @@index([assigneeId, status])
  @@index([status, dueAt])
  @@index([categoryId, createdAt])
  @@index([reviewAt, reviewOutcome])
  @@index([createdAt])
}

/// تیک زدن **رویداد نمی‌سازد و اعلان نمی‌دهد** (وگرنه تاریخچه نویز می‌گیرد)،
/// ولی چه کسی و کِی تیک زد روی خود بند می‌ماند.
model SeoTaskChecklistItem {
  id         String    @id @default(cuid())
  taskId     String
  title      String
  sortOrder  Int       @default(0)
  doneAt     DateTime?
  doneById   String?
  doneByName String?
  createdAt  DateTime  @default(now())

  task SeoTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, sortOrder])
}

model SeoTaskFile {
  id             String    @id @default(cuid())
  taskId         String
  /// مسیر عمومی فایل — همان خروجی /api/admin/upload
  url            String
  fileName       String
  mimeType       String?
  size           Int?
  uploadedById   String?
  uploadedByName String
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  task SeoTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

/// ⚠️ `actorId` خالی‌پذیر است: ساخت از الگو و یادآوری بررسی کارِ **سیستم** است
/// و نسبت‌دادنش به سازنده‌ی الگو تاریخچه را دروغ می‌کند.
model SeoTaskEvent {
  id         String               @id @default(cuid())
  taskId     String
  actorId    String?
  actorName  String?
  action     MarketingEventAction
  fromStatus SeoTaskStatus?
  toStatus   SeoTaskStatus?
  note       String?
  createdAt  DateTime             @default(now())

  task SeoTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([actorId, createdAt])
}

/// الگوی کار دوره‌ای. زمان‌بند (`lib/worklist/scheduler.ts`) در موعد از رویش
/// یک `SeoTask` عادی می‌سازد.
///
/// ⚠️ سه قاعده در بخش ۵.۶ مستندات: عقب‌افتادگی انباشته نمی‌شود، تا کار قبلی
/// باز است کار تازه ساخته نمی‌شود، و «قبضه»ی اتمیک روی `nextRunAt` جلوی
/// ساخت تکراری در چند پروسه‌ی pm2 را می‌گیرد.
model SeoRecurringTask {
  id           String        @id @default(cuid())
  title        String
  categoryId   String
  description  String?
  pageUrls     String?
  assigneeId   String?
  assigneeName String
  priority     StaffPriority @default(NORMAL)
  /// بندهای چک‌لیست: آرایه‌ی رشته
  checklist    Json          @default("[]")

  unit             SeoRecurrenceUnit @default(MONTH)
  /// «هر N هفته/ماه»
  intervalCount    Int               @default(1)
  /// مهلت نسبی: N روز بعد از ساخت
  dueOffsetDays    Int?
  /// N روز بعد از تأیید، بررسی نتیجه یادآوری شود
  reviewOffsetDays Int?

  nextRunAt DateTime
  lastRunAt DateTime?
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  category SeoTaskCategory @relation(fields: [categoryId], references: [id])
  tasks    SeoTask[]

  @@index([isActive, nextRunAt])
}

// ───────────────────────────── محتوا ─────────────────────────────

enum ContentTaskStatus {
  ASSIGNED
  WRITING
  AWAITING_PUBLISH
  PUBLISHING
  AWAITING_APPROVAL
  DONE
  CANCELED
}

/// محتوا برای مجله‌ی خودمان است یا برای سایت میزبانِ یک گره‌ی لینک‌سازی.
/// این تفکیک در برتر لازم نبود چون همه‌ی محتوا بیرونی بود.
enum ContentDestination {
  BLOG // منتشر در BlogPost همین فروشگاه
  EXTERNAL // تحویل متن؛ publishedUrl دستی پر می‌شود
}

model ContentTask {
  id              String             @id @default(cuid())
  code            Int                @default(autoincrement())
  title           String
  primaryKeyword  String?
  relatedKeywords String?
  /// بریف مدیر
  brief           String?
  destination     ContentDestination @default(BLOG)

  writerId      String?
  writerName    String
  publisherId   String?
  publisherName String?
  createdById   String?
  createdByName String

  status   ContentTaskStatus @default(ASSIGNED)
  priority StaffPriority     @default(NORMAL)
  dueAt    DateTime?

  /// پیش‌نویس تا لحظه‌ی ساخت مقاله. از وقتی `blogPostId` پر شد، منبع حقیقتِ
  /// متن **`BlogPost.content`** است و اینجا دیگر نوشته نمی‌شود (بخش ۶.۲).
  body         String?
  wordCount    Int?
  blogPostId   String? @unique
  publishedUrl String?

  returnReason   String?
  cancelReason   String?
  startedAt      DateTime?
  submittedAt    DateTime?
  publishedAt    DateTime?
  approvedAt     DateTime?
  approvedById   String?
  approvedByName String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  blogPost BlogPost?          @relation(fields: [blogPostId], references: [id], onDelete: SetNull)
  files    ContentTaskFile[]
  events   ContentTaskEvent[]
  linkNode LinkNode?

  @@index([writerId, status])
  @@index([publisherId, status])
  @@index([status, dueAt])
  @@index([createdAt])
}

model ContentTaskFile {
  id             String    @id @default(cuid())
  taskId         String
  url            String
  fileName       String
  mimeType       String?
  size           Int?
  uploadedById   String?
  uploadedByName String
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  task ContentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model ContentTaskEvent {
  id         String               @id @default(cuid())
  taskId     String
  actorId    String?
  actorName  String?
  action     MarketingEventAction
  fromStatus ContentTaskStatus?
  toStatus   ContentTaskStatus?
  note       String?
  createdAt  DateTime             @default(now())

  task ContentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([actorId, createdAt])
}

// ──────────────────────── لینک‌سازی خارجی ────────────────────────

enum LinkCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  DONE
}

enum LinkNodeStatus {
  PLANNED
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  LIVE
  FAILED
  LOST
}

enum LinkAnchorKind {
  EXACT // تطابق دقیق
  PARTIAL // تطابق جزئی
  BRAND
  BRAND_KEYWORD
  NAKED_URL // آدرس خام
  GENERIC // اینجا، بیشتر بخوانید
  IMAGE // انکر همان alt است
}

enum LinkContentKind {
  NONE
  TEXT
  IMAGE
  VIDEO
  AUDIO
}

/// نوع لینک — «وبلاگ Web 2.0». آیکنش از lucide-react می‌آید.
/// گزارش‌ها روی **نوع** جمع می‌شوند نه پلتفرم.
model LinkType {
  id                 String          @id @default(cuid())
  key                String?         @unique
  title              String
  /// نام آیکن lucide-react
  icon               String?
  description        String?
  /// کِی به کار می‌آید و تله‌اش چیست — آموزش کارمند تازه
  seoNote            String?
  sampleSites        String?
  /// پیش‌فرض‌های هوشمند فرم گره؛ قفل نیستند
  defaultContentKind LinkContentKind @default(NONE)
  defaultUgc         Boolean         @default(false)
  defaultSponsored   Boolean         @default(false)
  /// PBN — روشِ لینک‌سازی ریسک جریمه دارد. هشدار قرمز در فرم.
  isRisky            Boolean         @default(false)
  isActive           Boolean         @default(true)
  sortOrder          Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  platforms LinkPlatform[]
  nodes     LinkNode[]

  @@index([isActive, sortOrder])
}

/// پلتفرم — «ویرگول». دامنه و حساب کاربری دارد.
///
/// ⚠️ `iconPath` را **فقط اسکریپت لوکال** می‌نویسد؛ سرور هیچ‌وقت برای آیکن به
/// اینترنت وصل نمی‌شود و مسیر از روی دامنه حدس زده نمی‌شود (پسوند همیشه png
/// نیست). خالی بودنش یعنی آیکن نوع نشان داده شود.
model LinkPlatform {
  id              String   @id @default(cuid())
  typeId          String
  title           String
  domain          String
  accountNote     String?
  iconPath        String?
  /// قدرت دامنه — فعلاً دستی؛ فاز آنالیز خودکارش می‌کند
  domainAuthority Int?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  type  LinkType   @relation(fields: [typeId], references: [id])
  nodes LinkNode[]

  @@unique([typeId, domain])
  @@index([isActive, sortOrder])
}

model LinkCampaign {
  id            String             @id @default(cuid())
  title         String
  note          String?
  status        LinkCampaignStatus @default(DRAFT)
  /// سقف لینک تازه در هفته — برنامه‌ساز مهلت‌ها را با آن پخش می‌کند.
  /// راهنماست نه قفل.
  weeklyQuota   Int?
  /// کلید بازه‌ی مرجع توزیع انکر — پیش‌فرض «فروشگاه اینترنتی»
  anchorProfile String             @default("ECOMMERCE")
  /// چیدمان بوم یک‌بار ذخیره شده یا نه — (۰،۰) دو معنی دارد (تله‌ی ۶)
  isPristine    Boolean            @default(true)
  deletedAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  targets LinkTarget[]
  nodes   LinkNode[]
  edges   LinkEdge[]

  @@index([status, createdAt])
}

/// صفحه‌ی هدف — ردیف است نه ستون روی کمپین، چون توزیع انکر برای هر صفحه
/// معنی جدا دارد و هشدار روی سطح صفحه هم لازم است.
model LinkTarget {
  id             String   @id @default(cuid())
  campaignId     String
  url            String
  primaryKeyword String?
  isActive       Boolean  @default(true)
  posX           Float    @default(0)
  posY           Float    @default(0)
  createdAt      DateTime @default(now())

  campaign LinkCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  edges    LinkEdge[]

  @@index([campaignId, isActive])
}

/// یک لینک خارجی که قرار است ساخته شود — واحد کار.
///
/// ⚠️ `publishedUrl` آدرس صفحه‌ای است که ما لینک را **در آن** گذاشتیم.
/// آدرسِ **مقصد** از یال درمی‌آید، نه از ستون. جابه‌جا شدنشان کل گزارش را
/// بی‌معنی می‌کند (تله‌ی ۱).
///
/// ⚠️ `tier` از چارت مشتق می‌شود و فقط با تغییر یال بازمحاسبه می‌شود.
model LinkNode {
  id         String  @id @default(cuid())
  code       Int     @default(autoincrement())
  campaignId String
  typeId     String
  platformId String?
  note       String?

  anchorText   String?
  anchorKind   LinkAnchorKind?
  relFollow    Boolean         @default(true)
  relUgc       Boolean         @default(false)
  relSponsored Boolean         @default(false)

  contentKind  LinkContentKind @default(NONE)
  wordCount    Int?
  contentBrief String?
  profileTitle String?

  assigneeId   String?
  assigneeName String?
  status       LinkNodeStatus @default(PLANNED)
  dueAt        DateTime?
  publishedUrl String?
  /// هزینه‌ی ریالی اگر پولی بود — از حالا ثبت می‌شود هرچند گزارش بازدهی
  /// فاز بعد است؛ هزینه‌ای که موقعش ثبت نشود بعداً بازسازی نمی‌شود.
  cost         BigInt?

  contentTaskId String? @unique

  /// کوتاه‌ترین فاصله تا نزدیک‌ترین صفحه‌ی هدف؛ خالی یعنی «معلق»
  tier Int?
  posX Float @default(0)
  posY Float @default(0)

  submittedAt  DateTime?
  liveAt       DateTime?
  lostAt       DateTime?
  failReason   String?
  returnReason String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  campaign    LinkCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type        LinkType        @relation(fields: [typeId], references: [id])
  platform    LinkPlatform?   @relation(fields: [platformId], references: [id], onDelete: SetNull)
  contentTask ContentTask?    @relation(fields: [contentTaskId], references: [id], onDelete: SetNull)
  events      LinkNodeEvent[]
  outEdges    LinkEdge[]      @relation("LinkEdgeFrom")
  inEdges     LinkEdge[]      @relation("LinkEdgeTo")

  @@index([campaignId, status])
  @@index([assigneeId, status])
  @@index([typeId, createdAt])
  @@index([status, dueAt])
}

/// یال جدول جداست نه `parentId` روی گره — یک گره می‌تواند به چند مقصد لینک
/// بدهد و درخت این را نمی‌کشد.
///
/// ⚠️ **دقیقاً یکی** از `toNodeId` یا `toTargetId` پر است. این را هم zod
/// می‌گیرد هم قید `CHECK` دیتابیس، چون اسکریپت و سید و ترمیم دستی از zod رد
/// نمی‌شوند. قید دوم جلوی لینک گره به خودش را می‌گیرد.
model LinkEdge {
  id         String   @id @default(cuid())
  campaignId String
  fromNodeId String
  toNodeId   String?
  toTargetId String?
  createdAt  DateTime @default(now())

  campaign LinkCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  fromNode LinkNode     @relation("LinkEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode   LinkNode?    @relation("LinkEdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)
  toTarget LinkTarget?  @relation(fields: [toTargetId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([fromNodeId])
  @@index([toNodeId])
  @@index([toTargetId])
}

model LinkNodeEvent {
  id         String               @id @default(cuid())
  nodeId     String
  actorId    String?
  actorName  String?
  action     MarketingEventAction
  fromStatus LinkNodeStatus?
  toStatus   LinkNodeStatus?
  note       String?
  createdAt  DateTime             @default(now())

  node LinkNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, createdAt])
  @@index([actorId, createdAt])
}

// ───────────────────────────── اعلان ─────────────────────────────

enum StaffNotificationType {
  SEO_TASK
  CONTENT_TASK
  LINK_NODE
  ACC_CHEQUE // سررسید چک — حسابداری فاز ۵
}

/// اعلان درون‌پنلی کارمند.
///
/// عمداً **عمومی** است و به یک حوزه قفل نیست (برخلاف `StaffTaskReferral` که
/// به `StaffTask` می‌چسبد). `/api/admin/worklist/inbox` و `WorklistNotifier`
/// رویش سوار می‌شوند.
///
/// ⚠️ کسی به خودش اعلان نمی‌دهد. ⚠️ پیامک عمداً نیست.
/// ⚠️ این اعلان‌ها پاپ‌آپ فوری نمی‌گیرند — پاپ‌آپ مال ارجاع فوری کارتابل است
/// و ارزشش به کمیابی‌اش است.
model StaffNotification {
  id        String                @id @default(cuid())
  userId    String
  type      StaffNotificationType
  entityId  String
  title     String
  body      String?
  /// مسیر پنل که کلیک روی اعلان باز می‌کند
  url       String
  readAt    DateTime?
  createdAt DateTime              @default(now())

  @@index([userId, readAt, createdAt])
  @@index([type, entityId])
}

// ═══════════════════════════════════════════════════════════════════
// حسابداری — داخلی یا حسابان وب، پشت یک درگاه
// مستندات: docs/plans/accounting.md
//
// ⚠️ بخش‌های فروشگاه هرگز مستقیم حسابان یا دفتر داخلی را صدا نمی‌زنند؛ فقط
// `AccEvent` ثبت می‌کنند و `lib/accounting/dispatcher.ts` آن را به حسابداری
// فعال می‌رساند.
// ═══════════════════════════════════════════════════════════════════

/// حسابداری فعال — انحصاری (تصمیم ۱ سند).
enum AccMode {
  NONE // حسابداری انتخاب نشده؛ رویدادها ثبت می‌شوند ولی جایی نمی‌روند
  HESABAN // حسابان وب
  INTERNAL // حسابداری داخلی (از فاز ۲)
}

model AccSettings {
  id                    String    @id @default("singleton")
  mode                  AccMode   @default(NONE)
  modeChangedAt         DateTime?
  modeChangedBy         String?
  /// سال مالی پیش‌فرض فرم‌ها و گزارش‌ها
  currentYearId         String?
  /// تا این روز (شامل) هیچ سندی ساخته، بازسازی یا ابطال نمی‌شود
  lockDate              DateTime? @db.Date
  /// نرخ پیش‌فرض ارزش افزوده به صدم درصد — ۱۰٪ = 1000
  vatRateBp             Int       @default(1000)
  pricesIncludeVat      Boolean   @default(false)
  /// کسب‌وکار مشمول ارزش افزوده است؟ خاموش = فاکتورها بی‌مالیات (فاز ۴)
  vatEnabled            Boolean   @default(false)
  /// اطلاعات فروشنده — فاکتور رسمی و مودیان
  sellerName            String?
  sellerNationalId      String?
  sellerEconomicCode    String?
  sellerRegNo           String?
  sellerPostalCode      String?
  sellerAddress         String?
  sellerPhone           String?
  stampImage            String?
  signatureImage        String?
  invoiceFooterNote     String?
  /// ثبت خودکار (فاز ۶): واریز اقساط کارتابل روی کدام صندوق/بانک می‌نشیند
  installmentTreasuryId String?
  /// ثبت خودکار (فاز ۶): تسویه‌ی پورسانت از کدام صندوق/بانک پرداخت می‌شود
  payoutTreasuryId      String?
  updatedAt             DateTime  @updatedAt
}

enum AccYearStatus {
  OPEN
  CLOSED
}

/// سال مالی. تاریخ‌ها روز تهران‌اند (UTC نیمه‌شبِ همان روز، مثل `dayKeyOf`).
model AccFiscalYear {
  id           String        @id @default(cuid())
  title        String
  startDate    DateTime      @unique @db.Date
  endDate      DateTime      @db.Date
  status       AccYearStatus @default(OPEN)
  closedAt     DateTime?
  closedByName String?
  createdAt    DateTime      @default(now())

  vouchers AccVoucher[]
}

/// شماره‌گذاری پیوسته. ⚠️ فقط از `nextNumber` — یک UPSERT اتمیک، نه max+1 (تله‌ی ۵)
model AccSequence {
  yearId String
  key    String
  next   Int    @default(1)

  @@id([yearId, key])
}

enum AccLevel {
  GROUP // گروه
  LEDGER // کل
  SUBLEDGER // معین — فقط این سطح در سند می‌نشیند
}

enum AccNature {
  DEBIT
  CREDIT
  BOTH
}

enum AccClass {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

/// تفصیلیِ مجاز روی یک معین
enum AccDetailKind {
  NONE
  PARTY
  TREASURY
}

/// سرفصل حساب‌ها — گروه، کل، معین.
///
/// ⚠️ کد هیچ‌وقت کد حساب را hardcode نمی‌کند؛ حساب‌های سیستمی با `systemKey`
///    پیدا می‌شوند (`accountByKey`). حساب سیستمی حذف و غیرفعال نمی‌شود.
model AccAccount {
  id         String        @id @default(cuid())
  code       String        @unique
  name       String
  level      AccLevel
  parentId   String?
  class      AccClass
  nature     AccNature
  detailKind AccDetailKind @default(NONE)
  systemKey  String?       @unique
  isActive   Boolean       @default(true)
  /// شناسه در حسابان — فقط برای انتقال (فاز ۸)
  hesabanId  Int?
  createdAt  DateTime      @default(now())

  parent     AccAccount?      @relation("AccTree", fields: [parentId], references: [id])
  children   AccAccount[]     @relation("AccTree")
  lines      AccVoucherLine[]
  moneyLines AccMoneyLine[]

  @@index([parentId])
}

enum AccPersonType {
  REAL
  LEGAL
}

/// شخص — طرف حساب (تفصیلی). مانده ذخیره نمی‌شود؛ از ردیف‌های سند جمع زده می‌شود.
model AccParty {
  id            String        @id @default(cuid())
  code          Int           @unique
  personType    AccPersonType @default(REAL)
  name          String
  firstName     String?
  lastName      String?
  companyName   String?
  nationalId    String?
  economicCode  String?
  regNo         String?
  mobile        String?
  phone         String?
  postalCode    String?
  address       String?
  city          String?
  isCustomer    Boolean       @default(false)
  isSupplier    Boolean       @default(false)
  isEmployee    Boolean       @default(false)
  isMarketplace Boolean       @default(false)
  creditLimit   BigInt?
  userId        String?       @unique
  supplierId    String?       @unique
  platformCode  String?       @unique
  hesabanId     Int?
  note          String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  lines     AccVoucherLine[]
  invoices  AccInvoice[]
  moneyDocs AccMoneyDoc[]
  cheques   AccCheque[]

  @@index([mobile])
  @@index([name])
}

enum AccTreasuryKind {
  CASH
  BANK
  POS
  GATEWAY
}

/// صندوق، حساب بانکی، کارتخوان یا درگاه — تفصیلیِ حساب‌های نقد.
model AccTreasury {
  id         String          @id @default(cuid())
  code       Int             @unique
  kind       AccTreasuryKind
  name       String
  bankName   String?
  accountNo  String?
  sheba      String?
  cardNo     String?
  /// کارتخوان/درگاه به کدام بانک تسویه می‌شود
  settleToId String?
  /// درگاه‌های پرداخت سایت (`Payment.provider`) که به این خزانه می‌نشینند
  providers  String[]        @default([])
  isActive   Boolean         @default(true)
  hesabanId  Int?
  createdAt  DateTime        @default(now())

  lines AccVoucherLine[]
}

enum AccVoucherStatus {
  POSTED
  VOID
}

enum AccSource {
  MANUAL
  SALES_INVOICE
  PURCHASE_INVOICE
  SALES_RETURN
  PURCHASE_RETURN
  RECEIPT
  PAYMENT
  EXPENSE
  TRANSFER
  CHEQUE
  INVENTORY
  PAYOUT
  OPENING
  CLOSING
  IMPORT
  WALLET // شارژ یا کسر دستی کیف پول مشتری (فاز ۶)
}

/// سند حسابداری. ⚠️ فقط از `lib/accounting/ledger/post.ts` نوشته می‌شود —
/// ناورداها (توازن، یک‌طرفه بودن ردیف، تفصیلی، تاریخ باز) همان‌جا چک می‌شوند.
model AccVoucher {
  id            String           @id @default(cuid())
  yearId        String
  number        Int
  date          DateTime         @db.Date
  description   String
  status        AccVoucherStatus @default(POSTED)
  source        AccSource
  sourceId      String?
  /// سند معکوسی که این سند را خنثی کرد، یا سندی که این معکوسِ آن است
  reversalOfId  String?          @unique
  totalDebit    BigInt
  voidReason    String?
  createdById   String?
  createdByName String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  year  AccFiscalYear    @relation(fields: [yearId], references: [id])
  lines AccVoucherLine[]

  @@unique([yearId, number])
  @@index([source, sourceId])
  @@index([date])
}

model AccVoucherLine {
  id          String   @id @default(cuid())
  voucherId   String
  seq         Int
  accountId   String
  partyId     String?
  treasuryId  String?
  debit       BigInt   @default(0)
  credit      BigInt   @default(0)
  description String?
  /// denormalize برای گزارش بدون join — همیشه با سند هم‌زمان نوشته می‌شود
  date        DateTime @db.Date
  yearId      String
  isVoid      Boolean  @default(false)

  voucher  AccVoucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  account  AccAccount   @relation(fields: [accountId], references: [id])
  party    AccParty?    @relation(fields: [partyId], references: [id])
  treasury AccTreasury? @relation(fields: [treasuryId], references: [id])

  @@index([voucherId])
  @@index([accountId, date])
  @@index([partyId, date])
  @@index([treasuryId, date])
  @@index([yearId, isVoid])
}

enum AccEventStatus {
  PENDING // منتظر پردازش (یا در حالت دستی حسابان، منتظر ادمین)
  DONE // کامل در حسابداری ثبت شد
  BLOCKED // داده ناقص است (مثلاً نگاشت) — با رفع مشکل خودش برمی‌گردد
  FAILED // چند بار تلاش شد و نشد — فقط با «تلاش دوباره»ی ادمین برمی‌گردد
  SKIPPED // چیزی برای ثبت نماند (مثلاً همه‌ی اقلام لغو شدند)
}

/// یک رویداد مالی — صف outbox.
///
/// ⚠️ `dedupeKey` یکتاست: گذار تکراری یا webhook تکراری رویداد دوم نمی‌سازد.
/// ⚠️ رویداد فروش بازارگاه/سایت در فاز ۰ «تصویر گروهی» ردیف‌های `IntegOrder`
///    همان سفارش است: وضعیتش از وضعیت آن ردیف‌ها حساب می‌شود
///    (`syncSaleEvent`)، نه جداگانه نوشته می‌شود.
model AccEvent {
  id            String         @id @default(cuid())
  /// "SALE_ISSUED" | … — فهرست در lib/accounting/events.ts
  type          String
  aggregateType String
  aggregateId   String
  dedupeKey     String         @unique
  payload       Json           @default("{}")
  status        AccEventStatus @default(PENDING)
  /// حالتی که آخرین بار با آن پردازش شد
  mode          AccMode?
  attempts      Int            @default(0)
  nextAttemptAt DateTime       @default(now())
  /// قفل کوتاه‌مدت پردازش — worker و دکمه‌ی دستی هم‌زمان یک رویداد را نگیرند
  lockedUntil   DateTime?
  lastError     String?
  blockedReason String?
  /// شناسه در مقصد — مثلاً GUID فاکتور حسابان
  resultRef     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  processedAt   DateTime?

  @@index([status, nextAttemptAt])
  @@index([aggregateType, aggregateId])
  @@index([createdAt])
}

// ── حسابداری — کالا و انبار (فاز ۳، docs/plans/accounting.md بخش ۶.۵ و ۸) ──

model AccWarehouse {
  id        String   @id @default(cuid())
  code      Int      @unique
  name      String
  address   String?
  /// موجودی این انبار در `Product.stock` (قابل فروش در سایت) حساب می‌شود؟
  sellable  Boolean  @default(true)
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  hesabanId Int?
  createdAt DateTime @default(now())
}

/// موجودی فعلی هر کالا در هر انبار — کشِ جمع کاردکس، فقط از `inventory/stock.ts`
model AccStock {
  productId   String
  warehouseId String
  qty         Int    @default(0)

  @@id([productId, warehouseId])
  @@index([warehouseId])
}

/// بهای تمام‌شده‌ی هر کالا — میانگین موزون سراسری (تصمیم ۷).
/// `totalValue` منبع است و `avgCost` نمایشی؛ نگه‌داشتن ارزش کل جلوی
/// انباشت خطای گرد کردن میانگین را می‌گیرد.
model AccProductCost {
  productId  String   @id
  qtyOnHand  Int      @default(0)
  totalValue BigInt   @default(0)
  avgCost    BigInt   @default(0)
  /// آخرین بهای ورودی — وقتی موجودی صفر یا منفی است، خروج با همین قیمت‌گذاری می‌شود
  lastCost   BigInt   @default(0)
  /// شناسه‌ی مالیاتی کالا/خدمت (مودیان)
  taxCode    String?
  vatRateBp  Int?
  updatedAt  DateTime @updatedAt
}

enum AccMoveType {
  OPENING
  PURCHASE
  PURCHASE_RETURN
  SALE
  SALE_RETURN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUST_IN
  ADJUST_OUT
}

/// کاردکس. ترتیب پایدار: (date, createdAt, id).
///
/// ⚠️ `unitCost` و `totalCost` خروجی‌ها و `balance*` همه‌ی ردیف‌ها را فقط
///    `recalcProduct` می‌نویسد — ثبت با تاریخ گذشته ردیف‌های بعدی را بازسازی
///    می‌کند (تله‌ی ۲).
model AccStockMove {
  id            String      @id @default(cuid())
  productId     String
  warehouseId   String
  date          DateTime    @db.Date
  type          AccMoveType
  /// علامت‌دار: ورود مثبت، خروج منفی
  qty           Int
  /// ورودی: بهای خرید واحد (داده‌ی کاربر)؛ خروجی: میانگین لحظه (محاسبه)
  unitCost      BigInt      @default(0)
  /// |qty| × بها — همیشه نامنفی
  totalCost     BigInt      @default(0)
  /// موجودی و ارزش سراسری کالا بعد از این ردیف
  balanceQty    Int         @default(0)
  balanceValue  BigInt      @default(0)
  sourceType    String
  sourceId      String
  sourceLineId  String?
  note          String?
  createdByName String
  createdAt     DateTime    @default(now())

  @@index([productId, date, createdAt])
  @@index([sourceType, sourceId])
  @@index([warehouseId, productId])
}

enum AccDocStatus {
  DRAFT
  POSTED
  VOID
}

/// حواله‌ی انتقال بین انبارها — سند حسابداری ندارد (موجودی کالا یک حساب است)
model AccTransfer {
  id              String       @id @default(cuid())
  yearId          String
  number          Int
  date            DateTime     @db.Date
  fromWarehouseId String
  toWarehouseId   String
  note            String?
  status          AccDocStatus @default(POSTED)
  voidReason      String?
  createdByName   String
  createdAt       DateTime     @default(now())

  lines AccTransferLine[]

  @@unique([yearId, number])
  @@index([date])
}

model AccTransferLine {
  id         String @id @default(cuid())
  transferId String
  productId  String
  qty        Int

  transfer AccTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
}

/// انبارگردانی — پیش‌نویس تا شمارش تمام شود؛ ثبت، اختلاف را حرکت و سند می‌کند
model AccStockCount {
  id            String       @id @default(cuid())
  yearId        String
  number        Int
  date          DateTime     @db.Date
  warehouseId   String
  status        AccDocStatus @default(DRAFT)
  note          String?
  voucherId     String?      @unique
  voidReason    String?
  createdByName String
  postedByName  String?
  postedAt      DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  lines AccStockCountLine[]

  @@unique([yearId, number])
  @@index([status, date])
}

model AccStockCountLine {
  id         String @id @default(cuid())
  countId    String
  productId  String
  /// موجودی دفتری در تاریخ شمارش — در لحظه‌ی ثبت نوشته می‌شود
  systemQty  Int?
  countedQty Int
  /// counted − system
  diff       Int?

  count AccStockCount @relation(fields: [countId], references: [id], onDelete: Cascade)

  @@unique([countId, productId])
}

// ── حسابداری — فاکتورها (فاز ۴، docs/plans/accounting.md بخش ۶.۶ و ۱۰) ──

enum AccInvoiceType {
  SALES
  PURCHASE
  SALES_RETURN
  PURCHASE_RETURN
  PROFORMA
}

/// پیش‌نویس نه شماره دارد، نه سند، نه کاردکس. صدور هر سه را می‌سازد.
enum AccInvoiceStatus {
  DRAFT
  ISSUED
  VOID
}

/// فقط پیش‌فاکتور — «منقضی» ذخیره نمی‌شود، از `validUntil` خوانده می‌شود
enum AccProformaState {
  OPEN
  CONVERTED
  CANCELED
}

/// از کجا آمد — فاکتور خودکار (سایت، تلفنی، بازارگاه، کارتابل) از مسیر منبعش
/// اصلاح می‌شود، نه از فرم.
enum AccChannel {
  SHOP
  PHONE
  MARKETPLACE
  WORKLIST
  MANUAL
}

/// فاکتور فروش، خرید، برگشتی‌ها و پیش‌فاکتور.
///
/// ⚠️ فقط از `lib/accounting/invoices/service.ts` نوشته می‌شود — سند و کاردکس
///    هم‌زمان با فاکتور ساخته، بازسازی یا باطل می‌شوند.
/// ⚠️ مبالغ اسنپ‌شات محاسبه‌ی `invoices/calc.ts` است؛ گزارش‌ها از سند
///    می‌خوانند، نه از این جدول (بخش ۱۱).
model AccInvoice {
  id                String            @id @default(cuid())
  type              AccInvoiceType
  yearId            String
  /// در صدور گرفته می‌شود — پیش‌نویس شماره ندارد
  number            Int?
  date              DateTime          @db.Date
  dueDate           DateTime?         @db.Date
  status            AccInvoiceStatus  @default(DRAFT)
  proformaState     AccProformaState?
  /// اعتبار پیش‌فاکتور
  validUntil        DateTime?         @db.Date
  partyId           String
  channel           AccChannel        @default(MANUAL)
  platformCode      String?
  /// سفارش سایت/تلفنی — فروش و برگشت همان سفارش هر دو این را دارند
  orderId           String?
  /// کلید یکتای منبع خودکار: `order:<id>:sale`، `integ:<id>:sale`، `task:<id>:purchase`
  sourceKey         String?           @unique
  /// برگشتی ← فاکتور مرجع
  refInvoiceId      String?
  /// فاکتور ساخته‌شده از پیش‌فاکتور ← پیش‌فاکتور
  convertedFromId   String?           @unique
  warehouseId       String?
  /// قیمت‌های ردیف با مالیات است؟ (فاکتور خودکار فروشگاه همیشه: مشتری همان را پرداخته)
  pricesIncludeVat  Boolean           @default(false)
  /// اسنپ‌شات طرف حساب در لحظه‌ی صدور — چاپ رسمی و مودیان
  partyName         String
  partyNationalId   String?
  partyEconomicCode String?
  partyPostalCode   String?
  partyAddress      String?
  partyPhone        String?
  /// Σ تعداد × فی
  subtotal          BigInt            @default(0)
  lineDiscount      BigInt            @default(0)
  invoiceDiscount   BigInt            @default(0)
  /// کرایه و اضافات — فروش: درآمد ارسال؛ خرید: روی بهای کالا پخش می‌شود
  additions         BigInt            @default(0)
  additionsTitle    String?
  vatTotal          BigInt            @default(0)
  total             BigInt            @default(0)
  /// کش تخصیص دریافت/پرداخت (فاز ۵، تله‌ی ۶)
  paidTotal         BigInt            @default(0)
  note              String?
  voucherId         String?           @unique
  voidReason        String?
  /// مودیان — فاز ۹
  taxId             String?
  taxStatus         String?
  createdById       String?
  createdByName     String
  issuedAt          DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  party       AccParty         @relation(fields: [partyId], references: [id])
  lines       AccInvoiceLine[]
  allocations AccAllocation[]

  @@unique([yearId, type, number])
  @@index([partyId, date])
  @@index([type, status, date])
  @@index([orderId])
  @@index([refInvoiceId])
}

model AccInvoiceLine {
  id                   String  @id @default(cuid())
  invoiceId            String
  seq                  Int
  /// خالی = خدمت (بدون کاردکس) — حسابش در `accountId`
  productId            String?
  title                String
  unit                 String?
  qty                  Int
  unitPrice            BigInt
  /// تخفیف همین ردیف (کل ردیف)
  discount             BigInt  @default(0)
  /// سهم این ردیف از تخفیف فاکتور — `calc.ts` پخش می‌کند، باقی گرد به ردیف آخر
  invoiceDiscountShare BigInt  @default(0)
  vatRateBp            Int     @default(0)
  vatAmount            BigInt  @default(0)
  /// ردیف پس از تخفیف‌ها + مالیات (در حالت قیمت با مالیات: همان مبلغ پس از تخفیف)
  lineTotal            BigInt
  /// ردیف خدمت: حساب درآمد (فروش) یا هزینه (خرید)
  accountId            String?
  /// برگشتی ← ردیف فاکتور مرجع (سقف تعداد قابل برگشت)
  refLineId            String?
  orderItemId          String?
  taxCode              String?

  invoice AccInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([productId])
  @@index([refLineId])
}

// ── حسابداری — دریافت، پرداخت، انتقال و چک (فاز ۵، docs/plans/accounting.md بخش ۶.۷، ۶.۸ و ۹) ──

enum AccMoneyKind {
  RECEIPT
  PAYMENT
  TRANSFER
  EXPENSE // هزینه — فاز ۶
}

enum AccMoneyMethod {
  CASH // نقد به صندوق
  CARD_TRANSFER // کارت‌به‌کارت
  BANK_TRANSFER // واریز/حواله‌ی بانکی (پایا، ساتنا)
  POS // کارتخوان
  GATEWAY // درگاه اینترنتی
  CHEQUE // چک — دریافت: چک تازه؛ پرداخت: چک تازه‌ی ما یا خرج چک دریافتی
  WALLET // کیف پول مشتری — فقط دریافت خودکار سفارش سایت (فاز ۶)
}

/// دریافت از شخص، پرداخت به شخص، یا انتقال بین صندوق و بانک.
///
/// ⚠️ فقط از `lib/accounting/treasury/money.ts` — سند، چک‌های ساخته‌شده و
///    تخصیص به فاکتورها با هم ثبت یا با هم باطل می‌شوند. ویرایش ندارد؛ ابطال و ثبت دوباره.
model AccMoneyDoc {
  id            String       @id @default(cuid())
  kind          AccMoneyKind
  yearId        String
  number        Int
  date          DateTime     @db.Date
  partyId       String?
  total         BigInt
  description   String?
  status        AccDocStatus @default(POSTED)
  voucherId     String?      @unique
  voidReason    String?
  /// پرداخت آنلاین سایت (`Payment`) — دریافت خودکار
  paymentId     String?      @unique
  /// کلید یکتای منبع خودکار — `payment:` `installment:` `payout:`
  sourceKey     String?      @unique
  /// هزینه: بخشی که پرداخت نشد و بدهی به شخص شد (نسیه)
  payable       BigInt       @default(0)
  /// هزینه: مالیات بر ارزش افزوده‌ی قابل کسر
  vatAmount     BigInt       @default(0)
  createdById   String?
  createdByName String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  party       AccParty?       @relation(fields: [partyId], references: [id])
  items       AccMoneyItem[]
  lines       AccMoneyLine[]
  allocations AccAllocation[]

  @@unique([yearId, kind, number])
  @@index([partyId, date])
  @@index([kind, date])
}

/// یک روش در یک دریافت/پرداخت — «بخشی نقد، بخشی چک»
model AccMoneyItem {
  id           String         @id @default(cuid())
  moneyDocId   String
  seq          Int
  method       AccMoneyMethod
  /// صندوق/بانک — انتقال: مبدأ
  treasuryId   String?
  /// فقط انتقال: مقصد
  toTreasuryId String?
  chequeId     String?
  amount       BigInt
  /// کارمزد بانکی (انتقال) — از مبدأ کم می‌شود
  fee          BigInt         @default(0)
  trackingCode String?

  moneyDoc AccMoneyDoc @relation(fields: [moneyDocId], references: [id], onDelete: Cascade)

  @@index([moneyDocId])
  @@index([chequeId])
}

/// ردیف هزینه — «بابت چه»: یک سند هزینه چند سرفصل می‌گیرد (اجاره + قبض).
model AccMoneyLine {
  id          String  @id @default(cuid())
  moneyDocId  String
  seq         Int
  accountId   String
  amount      BigInt
  description String?

  moneyDoc AccMoneyDoc @relation(fields: [moneyDocId], references: [id], onDelete: Cascade)
  account  AccAccount  @relation(fields: [accountId], references: [id])

  @@index([moneyDocId])
  @@index([accountId])
}

/// تسویه‌ی فاکتور با دریافت/پرداخت. ⚠️ `AccInvoice.paidTotal` کش همین جدول
/// است و فقط `recalcPaid` می‌نویسدش (تله‌ی ۶).
model AccAllocation {
  id         String @id @default(cuid())
  moneyDocId String
  invoiceId  String
  amount     BigInt

  moneyDoc AccMoneyDoc @relation(fields: [moneyDocId], references: [id], onDelete: Cascade)
  invoice  AccInvoice  @relation(fields: [invoiceId], references: [id])

  @@unique([moneyDocId, invoiceId])
  @@index([invoiceId])
}

enum AccChequeDir {
  RECEIVED
  ISSUED
}

enum AccChequeStatus {
  IN_HAND // دریافتی: نزد ما
  IN_COLLECTION // دریافتی: به بانک سپرده شد
  CLEARED // وصول شد / پاس شد
  BOUNCED // برگشتی
  ENDORSED // دریافتی: خرج شد به شخص دیگر
  RETURNED // عودت به صاحب / ابطال چک صادره
  ISSUED // صادره: منتظر سررسید
}

/// چک. وضعیت فقط با `lib/accounting/treasury/cheques.ts` عوض می‌شود — هر
/// گذار یک `AccChequeEvent` و سند خودش را دارد؛ گذار غیرمجاز رد می‌شود.
model AccCheque {
  id              String          @id @default(cuid())
  direction       AccChequeDir
  status          AccChequeStatus
  serialNo        String
  /// شناسه‌ی صیادی ۱۶ رقمی
  sayadId         String?
  sayadRegistered Boolean         @default(false)
  bankName        String
  branch          String?
  /// صاحب حساب (دریافتی)
  ownerName       String?
  amount          BigInt
  issueDate       DateTime?       @db.Date
  dueDate         DateTime        @db.Date
  /// دریافتی: از چه کسی؛ صادره: به چه کسی
  partyId         String
  /// خرج‌شده به
  holderPartyId   String?
  /// صادره: حساب بانکی ما؛ دریافتی: بانکی که برای وصول سپرده شد
  treasuryId      String?
  chequeBookId    String?
  /// دریافت/پرداختی که چک را ساخت
  moneyDocId      String?
  /// زمان یادآوری سررسید — ⚠️ **قبل از** ارسال نوشته می‌شود (مرز «دو بار نفرست»)
  reminderSentAt  DateTime?
  followUpTaskId  String?
  note            String?
  createdById     String?
  createdByName   String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  party  AccParty         @relation(fields: [partyId], references: [id])
  events AccChequeEvent[]

  @@index([direction, status, dueDate])
  @@index([partyId])
  @@index([moneyDocId])
}

model AccChequeEvent {
  id         String           @id @default(cuid())
  chequeId   String
  from       AccChequeStatus?
  to         AccChequeStatus
  date       DateTime         @db.Date
  voucherId  String?          @unique
  /// خرج چک: به چه کسی — بانک وصول/پاس
  partyId    String?
  treasuryId String?
  moneyDocId String?
  note       String?
  byName     String
  createdAt  DateTime         @default(now())

  cheque AccCheque @relation(fields: [chequeId], references: [id], onDelete: Cascade)

  @@index([chequeId, createdAt])
}

/// دسته‌چک — پیشنهاد شماره‌ی بعدی چک صادره
model AccChequeBook {
  id         String   @id @default(cuid())
  treasuryId String
  fromSerial String
  toSerial   String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([treasuryId])
}
