/// روش ارسال — **تنها منبع حقیقتِ روش ارسال و باربری**.
///
/// دو مصرف‌کننده دارد و هیچ فهرست ثابتی در کد نمی‌ماند:
///   • چک‌اوت سایت (`useInCheckout`)
///   • انتخابگر باربریِ کارتابل (`useInWorklist`)
///
/// مستندات: docs/plans/business-config.md بخش ۱
model ShippingMethod {
  id          String       @id @default(cuid())
  title       String
  type        ShippingType
  isActive    Boolean      @default(true)
  cities      String[] // لیست شهرهای مجاز (خالی = همه جا)
  fee         BigInt       @default(0)
  description String?
  sortOrder   Int          @default(0)

  /// مهلت تعهدشده بر حسب دقیقه — پیک تهران ۱۲۰، شهرستان ۱۴۴۰.
  /// `null` یعنی تعهد زمانی ندارد.
  slaMinutes    Int?
  /// کرایه با کیست. پیش‌فرض پس‌کرایه (مقصد می‌پردازد).
  feePayer      ShippingFeePayer @default(COLLECT)
  /// در انتخابگر باربریِ کارتابل دیده شود
  useInWorklist Boolean          @default(true)
  /// در چک‌اوت سایت به مشتری نشان داده شود
  useInCheckout Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

/// کرایه‌ی ارسال با کیست. پیش‌فرض `COLLECT` چون در ایران غالبِ ارسال شهرستان
/// پس‌کرایه است — ولی هر دو حالت پشتیبانی می‌شوند.
enum ShippingFeePayer {
  COLLECT // پس‌کرایه — مقصد می‌پردازد
  PREPAID // پیش‌کرایه — فروشگاه می‌دهد و از مشتری می‌گیرد
  FREE // رایگان — به عهده‌ی فروشگاه
}

