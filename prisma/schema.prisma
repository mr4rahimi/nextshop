generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String              @id @default(cuid())
  role          UserRole            @default(CUSTOMER)
  firstName     String?
  lastName      String?
  phone         String              @unique
  email         String?             @unique
  avatarUrl     String?
  nationalCode  String?
  passwordHash  String?
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  walletBalance BigInt              @default(0)
  addresses     Address[]
  cart          Cart?
  orders        Order[]
  reviews       Review[]
  reviewReplies Review[]            @relation("ReviewReplyBy")
  walletTx      WalletTransaction[]
  wishlist      WishlistItem[]
  guaranties    Guaranty[]
  blogComments  BlogComment[]
  clubProfile   ClubProfile?

  /// نقش کارتابل — جدا از `role`. خالی بودنش یعنی دسترسی کامل (سازگاری عقب‌رو).
  staffRoleId          String?
  staffRole            StaffRole?           @relation(fields: [staffRoleId], references: [id])
  staffOrders          Order[]              @relation("OrderCreatedByStaff")
  staffTasksAsCustomer StaffTask[]          @relation("StaffTaskCustomer")
  staffNotes           StaffNote[]
  /// حضوری یا دورکار — حضورِ کارمند دورکار با آی‌پی دفتر سنجیده نمی‌شود
  staffWorkMode        StaffWorkMode        @default(ONSITE)
  /// طرح پورسانت — خالی یعنی این کارمند پورسانت نمی‌گیرد
  commissionPlanId     String?
  commissionPlan       StaffCommissionPlan? @relation(fields: [commissionPlanId], references: [id], onDelete: SetNull)
  staffDealsOwned      StaffDeal[]          @relation("StaffDealOwner")
  staffDealsAsCustomer StaffDeal[]          @relation("StaffDealCustomer")
  staffPayouts         StaffPayout[]        @relation("StaffPayoutUser")
  ownedClubProfiles    ClubProfile[]        @relation("ClubProfileOwner")

  @@index([role])
  @@index([isActive])
  @@index([staffRoleId])
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  title       String?
  receiver    String
  phone       String
  province    String
  city        String
  addressLine String
  postalCode  String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@index([userId])
}

model Category {
  id              String                   @id @default(cuid())
  title           String
  slug            String                   @unique
  parentId        String?
  isActive        Boolean                  @default(true)
  sortOrder       Int                      @default(0)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  description     String?
  /// متن معرفی بالای گرید محصولات. `description` پایین گرید می‌آید.
  descriptionTop  String?
  /// سوالات متداول — آرایه‌ی [{question, answer}]. با `normalizeFaq()` امن شود.
  faq             Json?
  imageUrl        String?
  seoDescription  String?
  seoKeywords     String?
  seoTitle        String?
  parent          Category?                @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[]               @relation("CategoryTree")
  products        Product[]
  megaMenu        MegaMenuCategory?
  attributeGroups CategoryAttributeGroup[]
  landingPages    LandingPage[]
  commissionRules StaffCommissionRule[]

  @@index([parentId])
  @@index([isActive])
  @@index([sortOrder])
}

model Brand {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  logoUrl        String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  description    String?
  seoDescription String?
  seoKeywords    String?
  seoTitle       String?
  products       Product[]

  @@index([isActive])
}

model Product {
  id                 String             @id @default(cuid())
  title              String
  slug               String             @unique
  /// نو، استوک، دست‌دوم یا بازسازی‌شده — مبنای درصد پورسانت (بخش ۲۲.۵ کارتابل)
  condition          ProductCondition   @default(NEW)
  categoryId         String
  brandId            String?
  // شناسه‌های محصول برای Product schema و Google Merchant Center
  sku                String?
  gtin13             String?
  mpn                String?
  features           Json               @default("[]")
  colors             Json               @default("[]")
  price              BigInt             @default(0)
  salePrice          BigInt?
  warranty           String?
  stock              Int                @default(0)
  trackStock         Boolean            @default(false)
  lowStockThreshold  Int                @default(3)
  ratingAvg          Float              @default(0)
  ratingCount        Int                @default(0)
  isActive           Boolean            @default(true)
  assembledProductId String?            @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  expertDescription  String?
  expertImage        String?
  expertTitle        String?
  faq                Json               @default("[]")
  mainImage          String?
  seoDescription     String?
  seoKeywords        String?
  seoSchema          String?
  seoTitle           String?
  shortDescription   String?
  summaryDescription String?
  summaryFeatures    Json               @default("[]")
  summaryImage       String?
  summaryTitle       String?
  videoUrl           String?
  relatedSettings    Json               @default("{}")
  downloadTitle      String?
  downloadUrl        String?
  blogPosts          BlogPostProduct[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  assembledProduct   AssembledProduct?  @relation(fields: [assembledProductId], references: [id])
  brand              Brand?             @relation(fields: [brandId], references: [id])
  category           Category           @relation(fields: [categoryId], references: [id])
  images             ProductImage[]
  specs              ProductSpecValue[]
  reviews            Review[]
  wishlist           WishlistItem[]
  relatedProducts    ProductRelated[]   @relation("ProductRelations")
  relatedTo          ProductRelated[]   @relation("RelatedToProducts")
  attributes         ProductAttribute[]

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
  @@index([condition])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sortOrder])
}

/// نظر کاربر روی محصول.
///
/// `userId` عمداً اختیاری است: مهمان هم می‌تواند نظر بدهد و نامش در
/// `guestName` می‌نشیند. برای همین محدودیت یکتای قدیمی
/// `[productId, userId]` برداشته شد — مهمان‌ها اصلاً کلیدی برای یکتا شدن
/// ندارند و کاربر عضو هم می‌تواند بعد از خرید دوباره نظر بدهد.
///
/// همه‌ی نظرها با `status = PENDING` ثبت می‌شوند و فقط پس از تأیید ادمین
/// در صفحه‌ی محصول و در اسکیمای Review گوگل دیده می‌شوند.
///
/// مستندات: docs/features/reviews.md
model Review {
  id         String        @id @default(cuid())
  productId  String
  userId     String?
  /// نام مهمان — فقط وقتی userId خالی است پر می‌شود
  guestName  String?
  /// ایمیل اختیاری مهمان؛ هرگز عمومی نمایش داده نمی‌شود
  guestEmail String?
  rating     Int
  title      String?
  body       String?
  /// نقاط قوت و ضعف — در اسکیمای Review به positiveNotes/negativeNotes می‌روند
  pros       String[]      @default([])
  cons       String[]      @default([])
  /// آیا این محصول را پیشنهاد می‌کند؟ خالی یعنی نظری نداده
  recommends Boolean?
  /// در لحظه‌ی ثبت محاسبه می‌شود: کاربر این محصول را در سفارشی
  /// پرداخت‌شده یا تحویل‌شده خریده است
  isBuyer    Boolean       @default(false)
  status     CommentStatus @default(PENDING)
  /// رأی «مفید بود» — شمارنده‌ی مادی‌شده تا مرتب‌سازی ارزان بماند
  helpfulYes Int           @default(0)
  helpfulNo  Int           @default(0)
  /// پاسخ رسمی فروشگاه
  replyBody  String?
  replyAt    DateTime?
  replyById  String?
  /// برای تشخیص اسپم و محدودکردن ثبت پیاپی
  ip         String?
  userAgent  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @default(now()) @updatedAt
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  replyBy    User?         @relation("ReviewReplyBy", fields: [replyById], references: [id])
  votes      ReviewVote[]

  @@index([productId])
  @@index([userId])
  @@index([status])
  @@index([productId, status, createdAt])
}

/// رأی «مفید بود» روی یک نظر.
///
/// کلید یکتا روی `[reviewId, voterKey]` است؛ `voterKey` برای کاربر عضو
/// شناسه‌ی اوست و برای مهمان هش IP. این تنها چیزی است که مانع می‌شود
/// یک نفر با رفرش کردن صفحه شمارنده را بالا ببرد.
model ReviewVote {
  id        String   @id @default(cuid())
  reviewId  String
  voterKey  String
  helpful   Boolean
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, voterKey])
  @@index([reviewId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Order {
  id               String                   @id @default(cuid())
  userId           String
  addressId        String?
  status           OrderStatus              @default(PENDING_PAYMENT)
  itemsTotal       BigInt                   @default(0)
  shippingFee      BigInt                   @default(0)
  discountTotal    BigInt                   @default(0)
  /// کد تخفیف اعمال‌شده روی این سفارش — برای نمایش و گزارش
  couponCode       String?
  grandTotal       BigInt                   @default(0)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  orderNumber      String                   @unique
  note             String?
  trackingCode     String?
  /// کارمندی که این سفارش را از پنل ادمین ثبت کرده.
  /// `null` یعنی سفارش آنلاین — همین خالی‌بودن تعریفِ «سفارش سایت» است.
  createdByStaffId String?
  /// نقدی یا اعتباری. اعتباری یعنی کالا رفته و پول بعداً می‌آید.
  /// مستندات: docs/features/staff-worklist.md بخش ۲۴
  paymentTerm      OrderPaymentTerm         @default(CASH)
  /// فروش ریفری — مشتری را کسی معرفی کرده. پورسانتش با قاعده‌های `referral`
  /// طرح حساب می‌شود. مستندات: docs/features/staff-worklist.md بخش ۲۲.۱۰
  isReferral       Boolean                  @default(false)
  address          Address?                 @relation(fields: [addressId], references: [id])
  user             User                     @relation(fields: [userId], references: [id])
  createdByStaff   User?                    @relation("OrderCreatedByStaff", fields: [createdByStaffId], references: [id])
  staffDeal        StaffDeal?
  items            OrderItem[]
  payments         Payment[]
  installments     OrderCreditInstallment[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([createdByStaffId, createdAt])
  @@index([paymentTerm, status])
}

enum OrderPaymentTerm {
  CASH // نقدی — رفتار فعلی
  CREDIT // اعتباری — یک یا چند موعد پرداخت
}

enum CreditInstallmentStatus {
  DUE // هنوز نرسیده، یا رسیده و پرداخت نشده
  PAID
  CANCELED // سفارش لغو شد
}

/// یک موعد پرداخت اعتباری. سفارشِ یک‌جا یک ردیف دارد، قسطی چند ردیف.
///
/// ⚠️ **جمع مبلغ موعدها باید با مبلغ سفارش بخواند** — فرم تا نخواند ذخیره
/// نمی‌کند. بدون این قاعده، «مانده‌ی بدهی» هیچ‌وقت با فاکتور نمی‌خواند.
///
/// مستندات: docs/features/staff-worklist.md بخش ۲۴
model OrderCreditInstallment {
  id              String                  @id @default(cuid())
  orderId         String
  /// قسط چندم — از ۱
  seq             Int
  /// روز موعد. ساعت ندارد؛ مقایسه با کلید روزِ تهران انجام می‌شود (تله‌ی ۲۷)
  dueDate         DateTime                @db.Date
  amount          BigInt
  status          CreditInstallmentStatus @default(DUE)
  paidAt          DateTime?
  paidAmount      BigInt?
  /// شماره‌ی فیش، روش واریز
  paidNote        String?
  confirmedById   String?
  confirmedByName String?
  /// زمان ارسال یادآوری ۲۴ساعته — خالی یعنی هنوز نرفته.
  /// ⚠️ مرز «دو بار نفرست» همین است و **قبل از** صف‌کردن نوشته می‌شود.
  reminderSentAt  DateTime?
  /// کار پیگیری ساخته‌شده در کارتابل صاحب مشتری
  followUpTaskId  String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, seq])
  @@index([status, dueDate])
}

model OrderItem {
  id            String         @id @default(cuid())
  orderId       String
  productId     String
  qty           Int            @default(1)
  unitPrice     BigInt         @default(0)
  unitSalePrice BigInt?
  titleSnapshot String
  skuSnapshot   String?
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id])
  cost          OrderItemCost?

  @@index([orderId])
  @@index([productId])
}

/// قیمت خرید یک ردیف سفارش (کل ردیف، نه واحد) — تا وقتی سفارش پرداخت نشده و معامله‌اش
/// ساخته نشده، اینجا منتظر می‌ماند (بخش ۲۲.۱۰).
///
/// ⚠️ **عمداً جدول جداست، نه ستونی روی `OrderItem`.** قیمت خرید حساس‌ترین عدد
/// کسب‌وکار است و مسیرهای سفارش (از جمله صفحه‌ی سفارش مشتری) ردیف‌های
/// `OrderItem` را کامل برمی‌گردانند. رابطه فقط با `include` صریح می‌آید.
model OrderItemCost {
  orderItemId String    @id
  /// کل قیمت خرید همین ردیف — واحد × تعداد. کل ردیف ذخیره می‌شود تا پخشِ
  /// مبلغ یک کار خرید بین چند ردیف، ریال گرد شده گم نکند.
  cost        BigInt
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  status      PaymentStatus @default(PENDING)
  provider    String?
  providerRef String?
  amount      BigInt        @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

model WalletTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    BigInt
  reason    String
  meta      Json     @default("{}")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Template {
  id                String             @id @default(cuid())
  title             String
  slug              String             @unique
  isActive          Boolean            @default(true)
  defaultCategoryId String?
  defaultBrandId    String?
  basePrice         BigInt             @default(0)
  rulesVersion      Int                @default(1)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  assembled         AssembledProduct[]
  rules             Rule[]
  steps             TemplateStep[]

  @@index([isActive])
}

model ComponentType {
  id          String            @id @default(cuid())
  code        String            @unique
  title       String
  description String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  options     ComponentOption[]
  steps       TemplateStep[]
}

model ComponentOption {
  id              String               @id @default(cuid())
  componentTypeId String
  title           String
  slug            String?
  imageUrl        String?
  isActive        Boolean              @default(true)
  priceDelta      BigInt               @default(0)
  meta            Json                 @default("{}")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  assembledParts  AssembledComponent[]
  componentType   ComponentType        @relation(fields: [componentTypeId], references: [id])
  inventory       InventoryOption?
  stepOptions     TemplateStepOption[]

  @@unique([componentTypeId, slug])
  @@index([componentTypeId])
  @@index([isActive])
}

model TemplateStep {
  id              String               @id @default(cuid())
  templateId      String
  componentTypeId String
  title           String
  key             String
  sortOrder       Int
  isRequired      Boolean              @default(true)
  selectionMode   SelectionMode        @default(SINGLE)
  isActive        Boolean              @default(true)
  scope           Json                 @default("{}")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  assembled       AssembledComponent[]
  componentType   ComponentType        @relation(fields: [componentTypeId], references: [id])
  template        Template             @relation(fields: [templateId], references: [id], onDelete: Cascade)
  options         TemplateStepOption[]

  @@unique([templateId, key])
  @@index([templateId, sortOrder])
  @@index([componentTypeId])
  @@index([isActive])
}

model TemplateStepOption {
  id                String          @id @default(cuid())
  templateStepId    String
  componentOptionId String
  isActive          Boolean         @default(true)
  option            ComponentOption @relation(fields: [componentOptionId], references: [id], onDelete: Cascade)
  step              TemplateStep    @relation(fields: [templateStepId], references: [id], onDelete: Cascade)

  @@unique([templateStepId, componentOptionId])
  @@index([templateStepId])
  @@index([componentOptionId])
  @@index([isActive])
}

model Rule {
  id         String   @id @default(cuid())
  templateId String
  type       RuleType
  priority   Int      @default(100)
  isActive   Boolean  @default(true)
  condition  Json
  effect     Json
  message    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, type])
  @@index([isActive])
}

model AssembledProduct {
  id             String               @id @default(cuid())
  templateId     String
  hash           String               @unique
  rulesVersion   Int
  titleGenerated String?
  sku            String?
  priceFinal     BigInt
  createdAt      DateTime             @default(now())
  components     AssembledComponent[]
  template       Template             @relation(fields: [templateId], references: [id])
  cartItems      CartItem[]
  product        Product?

  @@index([templateId])
  @@index([rulesVersion])
}

model AssembledComponent {
  id                 String           @id @default(cuid())
  assembledProductId String
  templateStepId     String
  componentOptionId  String
  qty                Int              @default(1)
  assembledProduct   AssembledProduct @relation(fields: [assembledProductId], references: [id], onDelete: Cascade)
  componentOption    ComponentOption  @relation(fields: [componentOptionId], references: [id])
  templateStep       TemplateStep     @relation(fields: [templateStepId], references: [id])

  @@index([assembledProductId])
  @@index([templateStepId])
  @@index([componentOptionId])
}

model InventoryOption {
  id                String          @id @default(cuid())
  componentOptionId String          @unique
  stockQty          Int             @default(0)
  reservedQty       Int             @default(0)
  updatedAt         DateTime        @updatedAt
  componentOption   ComponentOption @relation(fields: [componentOptionId], references: [id], onDelete: Cascade)

  @@index([stockQty])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id                 String            @id @default(cuid())
  cartId             String
  productId          String
  qty                Int               @default(1)
  assembledProductId String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  assembled          AssembledProduct? @relation(fields: [assembledProductId], references: [id])
  cart               Cart              @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product            Product           @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@unique([cartId, assembledProductId])
  @@index([cartId])
  @@index([productId])
}

model SpecGroup {
  id        String     @id @default(cuid())
  title     String
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     SpecItem[]

  @@index([isActive])
}

model SpecItem {
  id            String             @id @default(cuid())
  groupId       String
  title         String
  sortOrder     Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  productValues ProductSpecValue[]
  group         SpecGroup          @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model ProductSpecValue {
  id         String   @id @default(cuid())
  productId  String
  specItemId String
  value      String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  specItem   SpecItem @relation(fields: [specItemId], references: [id], onDelete: Cascade)

  @@unique([productId, specItemId])
  @@index([productId])
  @@index([specItemId])
}

model Widget {
  id        String     @id @default(cuid())
  type      WidgetType
  title     String
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  config    Json       @default("{}")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model Story {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  linkUrl   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
