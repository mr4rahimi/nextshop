  channelPriority      Json    @default("[\"SMS\"]")
  smsInboxCursor       Int?

  // ── ربات بله ────────────────────────────────────────────────────
  // ⚠️ مثل smsApiKey، اختصاصی هر کسب‌وکار است. هر سایت ربات خودش را دارد،
  //    پس منبع حقیقت دیتابیس همان سایت است نه متغیر محیطی.
  baleBotToken      String?
  /// نام کاربری ربات بدون @ — برای ساخت لینک /start و QR
