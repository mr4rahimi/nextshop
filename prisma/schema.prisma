generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String              @id @default(cuid())
  role          UserRole            @default(CUSTOMER)
  firstName     String?
  lastName      String?
  phone         String              @unique
  email         String?             @unique
  avatarUrl     String?
  nationalCode  String?
  passwordHash  String?
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  walletBalance BigInt              @default(0)
  addresses     Address[]
  cart          Cart?
  orders        Order[]
  reviews       Review[]
  walletTx      WalletTransaction[]
  wishlist      WishlistItem[]
  guaranties    Guaranty[]
  blogComments  BlogComment[]
  clubProfile   ClubProfile?

  /// نقش کارتابل — جدا از `role`. خالی بودنش یعنی دسترسی کامل (سازگاری عقب‌رو).
  staffRoleId   String?
  staffRole     StaffRole?          @relation(fields: [staffRoleId], references: [id])
  staffOrders   Order[]             @relation("OrderCreatedByStaff")

  @@index([role])
  @@index([isActive])
  @@index([staffRoleId])
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  title       String?
  receiver    String
  phone       String
  province    String
  city        String
  addressLine String
  postalCode  String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@index([userId])
}

model Category {
  id              String                   @id @default(cuid())
  title           String
  slug            String                   @unique
  parentId        String?
  isActive        Boolean                  @default(true)
  sortOrder       Int                      @default(0)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  description     String?
  /// متن معرفی بالای گرید محصولات. `description` پایین گرید می‌آید.
  descriptionTop  String?
  /// سوالات متداول — آرایه‌ی [{question, answer}]. با `normalizeFaq()` امن شود.
  faq             Json?
  imageUrl        String?
  seoDescription  String?
  seoKeywords     String?
  seoTitle        String?
  parent          Category?                @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[]               @relation("CategoryTree")
  products        Product[]
  megaMenu        MegaMenuCategory?
  attributeGroups CategoryAttributeGroup[]
  landingPages LandingPage[]

  @@index([parentId])
  @@index([isActive])
  @@index([sortOrder])
}

model Brand {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  logoUrl        String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  description    String?
  seoDescription String?
  seoKeywords    String?
  seoTitle       String?
  products       Product[]

  @@index([isActive])
}

model Product {
  id                 String             @id @default(cuid())
  title              String
  slug               String             @unique
  categoryId         String
  brandId            String?
  // شناسه‌های محصول برای Product schema و Google Merchant Center
  sku                String?
  gtin13             String?
  mpn                String?
  features           Json               @default("[]")
  colors             Json               @default("[]")
  price              BigInt             @default(0)
  salePrice          BigInt?
  warranty           String?
  stock              Int                @default(0)
  trackStock         Boolean            @default(false)
  lowStockThreshold  Int                @default(3)
  ratingAvg          Float              @default(0)
  ratingCount        Int                @default(0)
  isActive           Boolean            @default(true)
  assembledProductId String?            @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  expertDescription  String?
  expertImage        String?
  expertTitle        String?
  faq                Json               @default("[]")
  mainImage          String?
  seoDescription     String?
  seoKeywords        String?
  seoSchema          String?
  seoTitle           String?
  shortDescription   String?
  summaryDescription String?
  summaryFeatures    Json               @default("[]")
  summaryImage       String?
  summaryTitle       String?
  videoUrl           String?
  relatedSettings    Json               @default("{}")
  downloadTitle      String?
  downloadUrl        String?
  blogPosts          BlogPostProduct[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  assembledProduct   AssembledProduct?  @relation(fields: [assembledProductId], references: [id])
  brand              Brand?             @relation(fields: [brandId], references: [id])
  category           Category           @relation(fields: [categoryId], references: [id])
  images             ProductImage[]
  specs              ProductSpecValue[]
  reviews            Review[]
  wishlist           WishlistItem[]
  relatedProducts    ProductRelated[]   @relation("ProductRelations")
  relatedTo          ProductRelated[]   @relation("RelatedToProducts")
  attributes         ProductAttribute[]

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sortOrder])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  userId     String
  rating     Int
  title      String?
  body       String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@index([isApproved])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Order {
  id            String      @id @default(cuid())
  userId        String
  addressId     String?
  status        OrderStatus @default(PENDING_PAYMENT)
  itemsTotal    BigInt      @default(0)
  shippingFee   BigInt      @default(0)
  discountTotal BigInt      @default(0)
  /// کد تخفیف اعمال‌شده روی این سفارش — برای نمایش و گزارش
  couponCode    String?
  grandTotal    BigInt      @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderNumber   String      @unique
  note          String?
  trackingCode  String?
  /// کارمندی که این سفارش را از پنل ادمین ثبت کرده.
  /// `null` یعنی سفارش آنلاین — همین خالی‌بودن تعریفِ «سفارش سایت» است.
  createdByStaffId String?
  address       Address?    @relation(fields: [addressId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
  createdByStaff User?      @relation("OrderCreatedByStaff", fields: [createdByStaffId], references: [id])
  items         OrderItem[]
  payments      Payment[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([createdByStaffId, createdAt])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  productId     String
  qty           Int     @default(1)
  unitPrice     BigInt  @default(0)
  unitSalePrice BigInt?
  titleSnapshot String
  skuSnapshot   String?
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  status      PaymentStatus @default(PENDING)
  provider    String?
  providerRef String?
  amount      BigInt        @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

model WalletTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    BigInt
  reason    String
  meta      Json     @default("{}")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Template {
  id                String             @id @default(cuid())
  title             String
  slug              String             @unique
  isActive          Boolean            @default(true)
  defaultCategoryId String?
  defaultBrandId    String?
  basePrice         BigInt             @default(0)
  rulesVersion      Int                @default(1)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  assembled         AssembledProduct[]
  rules             Rule[]
  steps             TemplateStep[]

  @@index([isActive])
}

model ComponentType {
  id          String            @id @default(cuid())
  code        String            @unique
  title       String
  description String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  options     ComponentOption[]
  steps       TemplateStep[]
}

model ComponentOption {
  id              String               @id @default(cuid())
  componentTypeId String
  title           String
  slug            String?
  imageUrl        String?
  isActive        Boolean              @default(true)
  priceDelta      BigInt               @default(0)
  meta            Json                 @default("{}")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  assembledParts  AssembledComponent[]
  componentType   ComponentType        @relation(fields: [componentTypeId], references: [id])
  inventory       InventoryOption?
  stepOptions     TemplateStepOption[]

  @@unique([componentTypeId, slug])
  @@index([componentTypeId])
  @@index([isActive])
}

model TemplateStep {
  id              String               @id @default(cuid())
  templateId      String
  componentTypeId String
  title           String
  key             String
  sortOrder       Int
  isRequired      Boolean              @default(true)
  selectionMode   SelectionMode        @default(SINGLE)
  isActive        Boolean              @default(true)
  scope           Json                 @default("{}")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  assembled       AssembledComponent[]
  componentType   ComponentType        @relation(fields: [componentTypeId], references: [id])
  template        Template             @relation(fields: [templateId], references: [id], onDelete: Cascade)
  options         TemplateStepOption[]

  @@unique([templateId, key])
  @@index([templateId, sortOrder])
  @@index([componentTypeId])
  @@index([isActive])
}

model TemplateStepOption {
  id                String          @id @default(cuid())
  templateStepId    String
  componentOptionId String
  isActive          Boolean         @default(true)
  option            ComponentOption @relation(fields: [componentOptionId], references: [id], onDelete: Cascade)
  step              TemplateStep    @relation(fields: [templateStepId], references: [id], onDelete: Cascade)

  @@unique([templateStepId, componentOptionId])
  @@index([templateStepId])
  @@index([componentOptionId])
  @@index([isActive])
}

model Rule {
  id         String   @id @default(cuid())
  templateId String
  type       RuleType
  priority   Int      @default(100)
  isActive   Boolean  @default(true)
  condition  Json
  effect     Json
  message    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, type])
  @@index([isActive])
}

model AssembledProduct {
  id             String               @id @default(cuid())
  templateId     String
  hash           String               @unique
  rulesVersion   Int
  titleGenerated String?
  sku            String?
  priceFinal     BigInt
  createdAt      DateTime             @default(now())
  components     AssembledComponent[]
  template       Template             @relation(fields: [templateId], references: [id])
  cartItems      CartItem[]
  product        Product?

  @@index([templateId])
  @@index([rulesVersion])
}

model AssembledComponent {
  id                 String           @id @default(cuid())
  assembledProductId String
  templateStepId     String
  componentOptionId  String
  qty                Int              @default(1)
  assembledProduct   AssembledProduct @relation(fields: [assembledProductId], references: [id], onDelete: Cascade)
  componentOption    ComponentOption  @relation(fields: [componentOptionId], references: [id])
  templateStep       TemplateStep     @relation(fields: [templateStepId], references: [id])

  @@index([assembledProductId])
  @@index([templateStepId])
  @@index([componentOptionId])
}

model InventoryOption {
  id                String          @id @default(cuid())
  componentOptionId String          @unique
  stockQty          Int             @default(0)
  reservedQty       Int             @default(0)
  updatedAt         DateTime        @updatedAt
  componentOption   ComponentOption @relation(fields: [componentOptionId], references: [id], onDelete: Cascade)

  @@index([stockQty])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id                 String            @id @default(cuid())
  cartId             String
  productId          String
  qty                Int               @default(1)
  assembledProductId String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  assembled          AssembledProduct? @relation(fields: [assembledProductId], references: [id])
  cart               Cart              @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product            Product           @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@unique([cartId, assembledProductId])
  @@index([cartId])
  @@index([productId])
}

model SpecGroup {
  id        String     @id @default(cuid())
  title     String
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     SpecItem[]

  @@index([isActive])
}

model SpecItem {
  id            String             @id @default(cuid())
  groupId       String
  title         String
  sortOrder     Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  productValues ProductSpecValue[]
  group         SpecGroup          @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model ProductSpecValue {
  id         String   @id @default(cuid())
  productId  String
  specItemId String
  value      String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  specItem   SpecItem @relation(fields: [specItemId], references: [id], onDelete: Cascade)

  @@unique([productId, specItemId])
  @@index([productId])
  @@index([specItemId])
}

model Widget {
  id        String     @id @default(cuid())
  type      WidgetType
  title     String
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  config    Json       @default("{}")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model Story {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  linkUrl   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  duration  Int      @default(5000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model HeroSlide {
  id        String   @id @default(cuid())
  title     String?
  imageUrl  String
  linkUrl   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
}

model ShippingMethod {
  id          String       @id @default(cuid())
  title       String
  type        ShippingType
  isActive    Boolean      @default(true)
  cities      String[] // لیست شهرهای مجاز (خالی = همه جا)
  fee         BigInt       @default(0)
  description String?
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([isActive])
}

model StoreSettings {
  id                       String   @id @default("singleton")

  cardNumber               String?
  cardHolder               String?
  cardBank                 String?
  cardReceiptInfo          String?
  paymentGatewayActive     Boolean  @default(false)
  paymentGatewayProvider   String?
  paymentGatewayMerchant   String?
  paymentGatewaySandbox    Boolean  @default(false)
  senderName               String?
  senderPhone              String?
  senderProvince           String?
  senderCity               String?
  senderAddress            String?
  senderPostalCode         String?
  storeName                String?
  storeLogo                String?
  siteFavicon              String?
  siteDescription          String?
  siteKeywords             String?
  siteEmail                String?
  sitePhone                String?
  siteAddress              String?
  siteCity                 String?
  siteProvince             String?
  sitePostalCode           String?
  openingHours             String? // schema.org format: "Sa-Th 09:00-17:00"
  socialInstagram          String?
  socialTelegram           String?
  socialWhatsapp           String?
  socialTwitter            String?
  footerText               String?
  enamadCode               String? // کد نماد اعتماد
  samanCode                String? // کد ساماندهی  
  trustBadge3              String? // نماد سوم (URL تصویر)
  trustBadge4              String? // نماد چهارم (URL تصویر)
  maintenanceMode          Boolean  @default(false)
  smsApiKey                String?
  smsLineNumber            String?
  smsEnabled               Boolean  @default(false)
  smsPatternOtp            String?
  smsPatternOrderNew       String?
  smsPatternOrderPaid      String?
  smsPatternOrderConfirm   String?
  smsPatternOrderPrepare   String?
  smsPatternOrderPack      String?
  smsPatternOrderSent      String?
  smsPatternOrderDelivered String?
  smsPatternOrderDone      String?
  smsPatternOrderCancel    String?
  walletEnabled            Boolean  @default(false)
  themeConfig              Json?
  homeHeaderVariant        String   @default("DEFAULT")
  mobileMenuGlass          Boolean  @default(false)
  headerGlassConfig        Json?
  productGridMobile        String   @default("single")
  chatSettings             Json?
  announcementBar          Json? // نوار اعلان بالای سایت — lib/announcementBar.ts
  updatedAt                DateTime @updatedAt

  clubEnabled          Boolean @default(false)
  clubName             String?
  smsMarketingLine     String?
  smsAllowedHourStart  Int     @default(9)
  smsAllowedHourEnd    Int     @default(21)
  smsMonthlyCapPerUser Int     @default(4)
  smsOptOutText        String? @default("لغو۱۱")
  /// امتیاز به‌ازای هر تومان خرید
  pointPerToman        Float   @default(0.001)
  pointExpiryDays      Int     @default(365)
  /// امتیاز رویدادها — ۰ یعنی آن رویداد امتیاز نمی‌دهد.
  /// ⚠️ هیچ‌کدام در کد ثابت نیست؛ همه از همین‌جا خوانده می‌شوند.
  pointOnSignup        Int     @default(0)
  pointOnBirthday      Int     @default(0)
  pointOnReview        Int     @default(0)
  /// امتیاز تشویقی برای دادن رضایت دریافت پیام — کلید حل نرخ پایین رضایت
  pointOnConsent       Int     @default(0)
  /// معرفی دوستان — امتیاز معرف و معرفی‌شده جدا تنظیم می‌شود
  pointOnReferrer      Int     @default(0)
  pointOnReferee       Int     @default(0)
  /// خرج کردن امتیاز
  pointRedeemEnabled   Boolean @default(false)
  /// ارزش هر امتیاز هنگام استفاده (تومان)
  pointRedeemRate      Float   @default(1)
  /// حداقل امتیاز لازم برای استفاده
  pointRedeemMin       Int     @default(0)
  /// سقف درصدی از مبلغ سفارش که با امتیاز قابل پرداخت است (۰ تا ۱۰۰)
  pointRedeemMaxPct    Int     @default(100)
  /// ترتیب اولویت کانال‌ها هنگام ارسال — آرایه‌ای از ClubChannel
  /// مثلاً ["TELEGRAM","BALE","SMS"] یعنی اول رایگان‌ها، بعد پیامک
  channelPriority      Json    @default("[\"SMS\"]")
  smsInboxCursor       Int?

  // ── ربات بله ────────────────────────────────────────────────────
  // ⚠️ مثل smsApiKey، اختصاصی هر کسب‌وکار است. هر سایت ربات خودش را دارد،
  //    پس منبع حقیقت دیتابیس همان سایت است نه متغیر محیطی.
  baleBotToken         String?
  /// نام کاربری ربات بدون @ — برای ساخت لینک /start و QR
  baleBotUsername      String?
  /// رشته‌ی تصادفی در مسیر وب‌هوک. بله `secret_token` ندارد، پس تنها راه
  /// محافظت، غیرقابل‌حدس بودن خودِ آدرس است.
  baleWebhookSecret    String?
  /// API کسب‌وکاری بله (سهمیه‌ی نرخ بالاتر، هزینه‌دار) به‌جای API معمولی
  baleBusinessApi      Boolean @default(false)
  /// نشانگر getUpdates — فقط برای حالت بدون وب‌هوک (توسعه‌ی لوکال)
  baleUpdateOffset     Int?
  /// کلید سفیر — ارسال با «شماره تلفن» بدون اینکه کاربر /start زده باشد.
  /// ⚠️ این کلید با توکن ربات فرق دارد؛ از پنل کسب‌وکار بله گرفته می‌شود و
  ///    ارسال از آن هزینه‌دار است.
  baleSafirKey         String?
  baleSafirEnabled     Boolean @default(false)

  /// کلمه/عدد کلیدی رضایت با پاسخ پیامکی — مشتری این را به خط خدماتی می‌فرستد
  smsOptInText         String? @default("عضویت")

  // ── کارتابل ─────────────────────────────────────────────────────
  /// پیش‌فرض خاموش: سایت‌های دیگر با دیپلوی بعدی منوی تازه نمی‌بینند.
  worklistEnabled      Boolean @default(false)
}

model MenuItem {
  id           String   @id @default(cuid())
  title        String
  url          String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  openInNewTab Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MegaMenuCategory {
  id         String   @id @default(cuid())
  categoryId String   @unique
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([sortOrder])
}

model FooterColumn {
  id        String        @id @default(cuid())
  title     String
  type      FooterColType
  isActive  Boolean       @default(true)
  sortOrder Int           @default(0)
  items     FooterItem[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([sortOrder])
}

model FooterItem {
  id        String       @id @default(cuid())
  columnId  String
  label     String
  url       String?
  sortOrder Int          @default(0)
  isActive  Boolean      @default(true)
  column    FooterColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@index([columnId])
}

model BlogCategory {
  id        String     @id @default(cuid())
  title     String
  slug      String     @unique
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  posts     BlogPost[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model BlogTag {
  id    String        @id @default(cuid())
  title String        @unique
  slug  String        @unique
  posts BlogPostTag[]
}

model BlogPost {
  id              String            @id @default(cuid())
  title           String
  slug            String            @unique
  excerpt         String?
  content         String
  coverImage      String?
  videoUrl        String?
  categoryId      String?
  status          BlogStatus        @default(DRAFT)
  publishedAt     DateTime?
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String?
  /// سوالات متداول — آرایه‌ی [{question, answer}]. با `normalizeFaq()` امن شود.
  faq             Json?
  viewCount       Int               @default(0)
  readingTime     Int               @default(0)
  category        BlogCategory?     @relation(fields: [categoryId], references: [id])
  tags            BlogPostTag[]
  comments        BlogComment[]
  relatedProducts BlogPostProduct[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@index([categoryId])
}

model BlogPostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model BlogPostProduct {
  postId    String
  productId String
  sortOrder Int      @default(0)
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([postId, productId])
}

model BlogComment {
  id        String        @id @default(cuid())
  postId    String
  userId    String?
  name      String?
  content   String
  status    CommentStatus @default(PENDING)
  parentId  String?
  post      BlogPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User?         @relation(fields: [userId], references: [id])
  parent    BlogComment?  @relation("replies", fields: [parentId], references: [id])
  replies   BlogComment[] @relation("replies")
  createdAt DateTime      @default(now())

  @@index([postId])
  @@index([status])
}

model ProductRelated {
  id        String  @id @default(cuid())
  productId String
  relatedId String
  sortOrder Int     @default(0)
  product   Product @relation("ProductRelations", fields: [productId], references: [id], onDelete: Cascade)
  related   Product @relation("RelatedToProducts", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedId])
  @@index([productId])
}

model AttributeGroup {
  id         String                   @id @default(cuid())
  title      String
  isActive   Boolean                  @default(true)
  sortOrder  Int                      @default(0)
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  attributes Attribute[]
  categories CategoryAttributeGroup[]

  @@index([isActive])
  @@index([sortOrder])
}

model Attribute {
  id           String             @id @default(cuid())
  groupId      String
  title        String
  slug         String
  isFilterable Boolean            @default(true)
  sortOrder    Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  group        AttributeGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  values       AttributeValue[]
  products     ProductAttribute[]

  @@unique([groupId, slug])
  @@index([groupId])
  @@index([isFilterable])
}

model AttributeValue {
  id          String             @id @default(cuid())
  attributeId String
  value       String
  slug        String?
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  attribute   Attribute          @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  products    ProductAttribute[]

  @@unique([attributeId, slug])
  @@index([attributeId])
}

model ProductAttribute {
  id               String         @id @default(cuid())
  productId        String
  attributeId      String
  attributeValueId String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute        Attribute      @relation(fields: [attributeId], references: [id])
  value            AttributeValue @relation(fields: [attributeValueId], references: [id])

  @@unique([productId, attributeId])
  @@index([productId])
  @@index([attributeId])
  @@index([attributeValueId])
}

model CategoryAttributeGroup {
  id               String         @id @default(cuid())
  categoryId       String
  attributeGroupId String
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attributeGroup   AttributeGroup @relation(fields: [attributeGroupId], references: [id], onDelete: Cascade)

  @@unique([categoryId, attributeGroupId])
  @@index([categoryId])
  @@index([attributeGroupId])
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FooterColType {
  LINKS // لینک‌های دلخواه
  CATEGORIES // دسته‌بندی‌های محصول (از DB)
  CONTACT // اطلاعات تماس + نمادها
  BRAND // لوگو + توضیحات + سوشال
}

enum ShippingType {
  EXPRESS // تحویل سریع با پیک
  STANDARD // ارسال عادی پست
}

enum WidgetType {
  STORY
  HERO_SLIDER
  CATEGORIES
  AMAZING_DEALS
  BEST_SELLERS
  PRODUCTS_BY_CATEGORY
  PRODUCTS_BY_BRAND
  NEWEST_PRODUCTS
  SPECIAL_OFFERS
  LAST_VISITED
  FULL_BANNER
  DOUBLE_BANNER
  CALL_TO_ACTION
  IMAGE_CONTENT
  IMAGE_CONTENT_DOUBLE
  LATEST_ARTICLES
  ADVANCED_SEARCH
  UNIQUE_STAR_HERO
  DIMENSIONAL_CARDS
  COVERFLOW_GALLERY
  SPACER
  PRODUCT_SHOWCASE
  CIRCLE_GALLERY
  RECT_BOXES
}

enum UserRole {
  CUSTOMER
  ADMIN
  SELLER
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  PROCESSING
  PACKAGING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum SelectionMode {
  SINGLE
  MULTI
}

enum RuleType {
  COMPATIBILITY
  REQUIRES
  EXCLUDES
  PRICE_RULE
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  OTHER
}

model MediaFile {
  id           String    @id @default(cuid())
  fileName     String
  originalName String
  url          String
  mimeType     String
  type         MediaType
  size         Int
  title        String?
  altText      String?
  folder       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([type])
  @@index([createdAt])
}

enum GuarantyRequestStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

model Guaranty {
  id           String   @id @default(cuid())
  userId       String
  serialNumber String   @unique
  productTitle String
  durationDays Int
  startDate    DateTime @default(now())
  endDate      DateTime
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id])
  requests GuarantyRequest[]

  @@index([userId])
  @@index([endDate])
}

model GuarantyRequest {
  id          String                @id @default(cuid())
  guarantyId  String
  description String
  status      GuarantyRequestStatus @default(PENDING)
  adminNote   String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  guaranty Guaranty @relation(fields: [guarantyId], references: [id])

  @@index([guarantyId])
  @@index([status])
}

model ChatConversation {
  id            String        @id @default(cuid())
  siteId        String?
  userId        String?
  sessionId     String?
  createdAt     DateTime      @default(now())
  lastMessageAt DateTime      @default(now())
  messages      ChatMessage[]

  @@index([siteId])
  @@index([userId])
  @@index([sessionId])
  @@index([lastMessageAt])
  @@index([siteId, userId])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           String // "user" | "assistant"
  content        String           @db.Text
  context        String? // مثل "topic:warranty" یا "category:printer" یا "free"
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model CallbackRequest {
  id             String   @id @default(cuid())
  siteId         String?
  conversationId String?
  userId         String?
  phone          String
  status         String   @default("pending") // pending | contacted | done
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([siteId])
  @@index([status])
  @@index([createdAt])
  @@index([siteId, status])
}

// ═══════════════════════════════════════════════════════════════════
// INTEGRATION HUB
// ═══════════════════════════════════════════════════════════════════

// ── پلتفرم‌های تعریف‌شده (seeded) ───────────────────────────────────

model IntegPlatform {
  code     String            @id
  name     String
  type     IntegPlatformType
  logoUrl  String?
  isActive Boolean           @default(true)

  connections      IntegConnection[]
  suggestions      IntegMappingSuggestion[]
  jobs             IntegJob[]
  logs             IntegLog[]
  platformProducts IntegPlatformProduct[]
}

enum IntegPlatformType {
  ACCOUNTING
  MARKETPLACE
}

// ── محصولات دریافت‌شده از هر پلتفرم ────────────────────────────────

model IntegPlatformProduct {
  id                String   @id @default(cuid())
  platformCode      String
  platformProductId String
  title             String
  sku               String?
  barcode           String?
  stock             Float?
  price             Float?
  originalPrice     Float?    // قیمت پیش از تخفیف — null یعنی تخفیفی نیست
  discountPercent   Float?    // درصد تخفیف فعال روی پلتفرم
  discountStartsAt  DateTime?
  discountEndsAt    DateTime?
  discountStock     Int?      // موجودی اختصاصی تخفیف (اسنپ‌شاپ)
  // آیا این ردیف بعد از افزوده‌شدن ردیابی تخفیف، تازه‌سازی شده؟
  // ردیف‌های قدیمی false می‌مانند؛ تا وقتی «دریافت محصولات» اجرا نشود
  // نمی‌دانیم محصول تخفیف دارد یا نه، پس قیمت برایش ارسال نمی‌شود.
  discountSynced    Boolean   @default(false)
  purchasePrice     Float?
  unit              String?
  isEnabled         Boolean  @default(true)
  rawData           Json     @default("{}")
  lastFetchedAt     DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  platform IntegPlatform @relation(fields: [platformCode], references: [code])

  @@unique([platformCode, platformProductId])
  @@index([platformCode])
  @@index([platformCode, isEnabled])
}

// ── اتصال به هر پلتفرم ──────────────────────────────────────────────

model IntegConnection {
  id               String          @id @default(cuid())
  platformCode     String
  siteId           String?
  credentials      String // JSON رمزنگاری‌شده AES-256-GCM
  status           IntegConnStatus @default(DISCONNECTED)
  lastSyncAt       DateTime?
  lastErrorAt      DateTime?
  lastError        String?
  config           Json            @default("{}")
  syncStockEnabled Boolean         @default(true)
  syncPriceEnabled Boolean         @default(false)
  syncIntervalMin  Int             @default(60)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  platform IntegPlatform @relation(fields: [platformCode], references: [code])

  @@unique([platformCode, siteId])
  @@index([status])
  @@index([platformCode])
}

enum IntegConnStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  SYNCING
}

// ── ظرف یکپارچه نگاشت (گروه چند پلتفرمه) ──────────────────────────

model IntegMapping {
  id               String    @id @default(cuid())
  notes            String?
  isActive         Boolean   @default(true)
  stock            Int       @default(0)
  syncStockEnabled Boolean   @default(true)
  lastStockSyncAt  DateTime?
  lastHesabanStock Int?

  purchasePriceSource IntegPurchasePriceSource @default(HESABAN)
  purchasePrice       Float?
  syncPriceEnabled    Boolean                  @default(true)
  lastPriceSyncAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links  IntegMappingLink[]
  orders IntegOrder[]
}

model IntegMappingLink {
  id            String   @id @default(cuid())
  mappingId     String
  platformCode  String // "shop" | "hesaban" | "basalam" | ...
  externalId    String // Product.id for "shop", platformProductId for others
  externalTitle String?
  isActive      Boolean  @default(true)
  meta          Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  mapping IntegMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade)

  @@unique([mappingId, platformCode])
  @@unique([platformCode, externalId])
  @@index([mappingId])
  @@index([platformCode])
  @@index([platformCode, isActive])
}

// ── پیشنهادهای auto-match ────────────────────────────────────────────

model IntegMappingSuggestion {
  id                String                @id @default(cuid())
  shopProductId     String
  platformCode      String
  platformProductId String
  platformTitle     String?
  confidence        Float
  matchReason       String?
  status            IntegSuggestionStatus @default(PENDING)
  reviewedAt        DateTime?
  createdAt         DateTime              @default(now())

  platform IntegPlatform @relation(fields: [platformCode], references: [code])

  @@index([shopProductId])
  @@index([platformCode, status])
  @@index([confidence])
}

enum IntegSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

// ── سفارش‌های دریافت‌شده از مارکت‌پلیس‌ها ─────────────────────────────

model IntegOrder {
  id                  String           @id @default(cuid())
  mappingId           String?
  platformCode        String
  platformOrderId     String
  platformOrderNo     String?  // شماره سفارش قابل نمایش برای کاربر (نه شناسه داخلی)
  platformOrderItemId String?
  productTitle        String
  qty                 Int
  unitPrice           Float?
  customerName        String?
  customerPhone       String?
  status              IntegOrderStatus @default(PENDING)
  blockedReason       String?  // چرا فاکتور نخورد — برای نمایش در ادمین
  invoicedAt          DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  mapping IntegMapping? @relation(fields: [mappingId], references: [id])

  @@unique([platformCode, platformOrderId])
  @@index([mappingId])
  @@index([platformCode, status])
  @@index([status])
  @@index([createdAt])
}

enum IntegOrderStatus {
  PENDING
  NEEDS_MAPPING // محصول نگاشت حسابداری ندارد — منتظر اقدام ادمین
  INVOICED
  CANCELLED
}

// ── Queue ────────────────────────────────────────────────────────────

model IntegJob {
  id           String         @id @default(cuid())
  type         IntegJobType
  platformCode String
  payload      Json
  status       IntegJobStatus @default(PENDING)
  priority     Int            @default(5)
  attempts     Int            @default(0)
  maxAttempts  Int            @default(3)
  lastError    String?
  scheduledAt  DateTime       @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime       @default(now())

  platform IntegPlatform @relation(fields: [platformCode], references: [code])
  logs     IntegLog[]

  @@index([status, scheduledAt])
  @@index([platformCode, status])
  @@index([priority, scheduledAt])
  @@index([type])
}

enum IntegJobType {
  SYNC_STOCK
  SYNC_PRICE
  SYNC_ALL_STOCK
  SYNC_ALL_PRICE
  FETCH_PRODUCTS
  FETCH_ORDERS
  CREATE_INVOICE // ثبت فاکتور فروش در حسابداری (فقط برای لاگ)
  CREATE_PRODUCT
  TEST_CONNECTION
}

enum IntegJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
  RETRYING
  CANCELLED
}

// ── Log ──────────────────────────────────────────────────────────────

model IntegLog {
  id            String            @id @default(cuid())
  jobId         String?
  platformCode  String
  operationType IntegJobType
  direction     IntegLogDirection
  entityType    IntegEntityType
  entityId      String?
  requestData   Json?
  responseData  Json?
  status        IntegLogStatus
  errorMessage  String?
  durationMs    Int?
  createdAt     DateTime          @default(now())

  job      IntegJob?     @relation(fields: [jobId], references: [id])
  platform IntegPlatform @relation(fields: [platformCode], references: [code])

  @@index([platformCode, createdAt])
  @@index([entityType, entityId])
  @@index([status])
  @@index([jobId])
  @@index([createdAt])
}

enum IntegLogDirection {
  INBOUND
  OUTBOUND
}

enum IntegEntityType {
  PRODUCT
  STOCK
  PRICE
  ORDER
  CONNECTION
}

enum IntegLogStatus {
  SUCCESS
  ERROR
  PARTIAL
}

// ── قوانین قیمت‌گذاری ────────────────────────────────────────────────

model IntegPriceRule {
  id               String   @id @default(cuid())
  name             String
  description      String?
  isActive         Boolean  @default(true)
  priority         Int      @default(100)
  targetPlatforms  String[] @default([]) // خالی = همه پلتفرم‌ها (شامل shop هم می‌شود)
  scopeCategoryIds String[] @default([])
  scopeBrandIds    String[] @default([])

  feePercent     Float         @default(0)
  shippingType   IntegCostType @default(FIXED)
  shippingValue  Float         @default(0)
  packagingType  IntegCostType @default(FIXED)
  packagingValue Float         @default(0)
  miscType       IntegCostType @default(FIXED)
  miscValue      Float         @default(0)
  marginPercent  Float         @default(0) // سود پیش‌فرض — وقتی هیچ tier ای match نشود
  roundTo        Int?

  tiers IntegPriceRuleTier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, priority])
}

enum IntegCostType {
  FIXED
  PERCENT
}

model IntegPriceRuleTier {
  id            String @id @default(cuid())
  ruleId        String
  minStock      Int? // null = بدون حد پایین
  maxStock      Int? // null = بدون حد بالا
  marginPercent Float
  sortOrder     Int    @default(0)

  rule IntegPriceRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}

// ── تنظیمات کلی ──────────────────────────────────────────────────────

model IntegSettings {
  id                String   @id @default("singleton")
  workerEnabled     Boolean  @default(true)
  workerIntervalSec Int      @default(30)
  maxConcurrentJobs Int      @default(5)
  logRetentionDays  Int      @default(30)
  updatedAt         DateTime @updatedAt
}

enum IntegPurchasePriceSource {
  HESABAN
  MANUAL
}

// ═══════════════════════════════════════════════════════════════════
// CUSTOMER CLUB — باشگاه مشتریان
// ═══════════════════════════════════════════════════════════════════

/// منبع *جذب* عضو — از کجا آمد. با «کانال ارتباطی» (ClubChannel) فرق دارد:
/// یکی می‌گوید از کجا آمد، دیگری می‌گوید از چه راهی به او برسیم.
enum ClubSource {
  ONLINE        // ثبت‌نام از سایت
  IN_STORE      // ثبت توسط فروشنده
  CALLER_ID     // دستگاه شماره‌گیر
  IMPORT        // ورود از فایل
  MARKETPLACE   // باسلام / تپسی‌شاپ / اسنپ‌شاپ / دیجی‌کالا / دیوار
  MESSAGING     // تلگرام / بله — عضویت از ربات پیام‌رسان
  REFERRAL      // معرفی توسط عضو دیگر
}

/// کانال ارتباطی — از چه راهی می‌شود به عضو پیام رساند.
/// ⚠️ عمداً از ClubSource جداست: عضوی که از باسلام آمده ممکن است بعداً در
///    تلگرام هم عضو شود؛ با یک enum مشترک یکی از این دو گم می‌شد.
enum ClubChannel {
  SMS
  TELEGRAM
  BALE
}

enum PointReason {
  PURCHASE
  MANUAL
  SIGNUP
  BIRTHDAY
  REFERRAL
  REVIEW
  CONSENT
  REDEEM
  EXPIRE
  ADJUST
}

model ClubProfile {
  id             String     @id @default(cuid())
  userId         String     @unique
  birthDate      DateTime?
  birthMonth     Int?       // ماه شمسی ۱-۱۲ — برای کوئری سریع کمپین تولد
  birthDay       Int?       // روز شمسی ۱-۳۱
  gender         String?
  source         ClubSource @default(ONLINE)
  sourcePlatform String?    // وقتی source = MARKETPLACE → "basalam" | "tapsi_shop"
  /// کد معرفی اختصاصی این عضو — با اولین درخواست ساخته می‌شود
  referralCode   String?    @unique
  /// عضوی که این شخص را معرفی کرده
  referredById   String?
  referredAt     DateTime?
  /// اولین نقطه‌ی تماس — ⚠️ هرگز بازنویسی نمی‌شود. مبنای گزارش «جذب از هر
  /// پلتفرم» است؛ `source` می‌تواند با فعالیت بعدی عضو عوض شود ولی این نه.
  firstSource    ClubSource?
  firstPlatform  String?
  firstSeenAt    DateTime?
  registeredById String?    // شناسه فروشنده‌ای که ثبت کرده
  tierId         String?
  totalSpent     BigInt     @default(0)
  orderCount     Int        @default(0)
  lastPurchaseAt DateTime?
  smsConsent     Boolean    @default(false)
  consentAt      DateTime?
  consentIp      String?
  isBlocked      Boolean    @default(false)
  tags           String[]   @default([])
  note           String?
  joinedAt       DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier           ClubTier?          @relation(fields: [tierId], references: [id])
  points         PointTransaction[]
  touchpoints    ClubTouchpoint[]
  identities     ClubChannelIdentity[]
  consentEvents  ClubConsentEvent[]

  @@index([tierId])
  @@index([firstSource, firstPlatform])
  @@index([referredById])
  @@index([birthMonth, birthDay])
  @@index([lastPurchaseAt])
  @@index([smsConsent])
  @@index([source])
  @@index([sourcePlatform])
  @@index([joinedAt])
}

model ClubTier {
  id        String        @id @default(cuid())
  title     String
  slug      String        @unique
  minSpent  BigInt        @default(0)
  color     String?
  pointRate Float         @default(1)
  benefits  Json          @default("[]")
  sortOrder Int           @default(0)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  profiles  ClubProfile[]

  @@index([isActive])
  @@index([sortOrder])
}

/// تاریخچه‌ی نقاط تماس عضو
///
/// یک ردیف به‌ازای هر بار که عضو از یک منبع دیده شد. بدون این، فقط «اولین» و
/// «آخرین» منبع را می‌دانیم و گزارش مسیر مشتری (باسلام ← سایت ← تلگرام)
/// ممکن نیست.
model ClubTouchpoint {
  id         String       @id @default(cuid())
  profileId  String
  source     ClubSource
  /// کد پلتفرم — "basalam" | "tapsi_shop" | "telegram" | "bale" | ...
  platform   String?
  /// اگر این تماس از یک کانال پیام‌رسان بود
  channel    ClubChannel?
  /// شناسه‌ی عضو در آن پلتفرم (chat_id تلگرام، شناسه‌ی خریدار باسلام و ...)
  externalId String?
  meta       Json?
  occurredAt DateTime     @default(now())

  profile    ClubProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, occurredAt])
  @@index([source, platform])
  @@index([occurredAt])
}

/// شناسه‌ی عضو در هر کانال ارتباطی
///
/// برای پیامک شماره‌ی موبایل روی `User` کافی است، ولی تلگرام و بله شناسه‌ی
/// اختصاصی خودشان (chat_id) را دارند که فقط بعد از استارت زدن کاربر به دست
/// می‌آید. بدون این جدول، ارسال چندکاناله ممکن نیست.
model ClubChannelIdentity {
  id          String      @id @default(cuid())
  profileId   String
  channel     ClubChannel
  /// chat_id تلگرام / شناسه‌ی بله / شماره برای SMS
  externalId  String
  /// نام کاربری قابل نمایش در آن پلتفرم
  username    String?
  /// کاربر می‌تواند در همان پلتفرم لغو کند بدون اینکه رکورد حذف شود
  isActive    Boolean     @default(true)
  subscribedAt DateTime   @default(now())
  lastSeenAt  DateTime?
  meta        Json?

  profile     ClubProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([channel, externalId])
  @@index([profileId, channel])
  @@index([channel, isActive])
}

/// منبعی که رضایت از آن گرفته شد — برای اثبات در صورت شکایت
enum ConsentSource {
  CHECKOUT      // تیک در صفحه تسویه‌حساب
  LANDING       // صفحه فرود عمومی / QR فروش حضوری
  SMS_REPLY     // پاسخ پیامکی با کلمه کلیدی
  PROFILE       // کلید در پنل کاربری خود مشتری
  MESSENGER     // /start در ربات بله یا تلگرام
  SELLER        // ثبت توسط فروشنده
  ADMIN         // تغییر دستی ادمین
  IMPORT        // ورود از فایل
}

/// دفتر تاریخچه‌ی رضایت — هر بار دادن یا پس‌گرفتن رضایت یک ردیف
///
/// ⚠️ `ClubProfile.smsConsent` فقط «وضعیت فعلی» است. بدون این دفتر، اگر
///    مشتری شکایت کند هیچ سندی از اینکه کِی و از کجا رضایت داده وجود ندارد.
///    بند ۷ سند باشگاه صراحتاً ثبت تاریخ و IP را لازم می‌داند.
model ClubConsentEvent {
  id        String        @id @default(cuid())
  profileId String
  /// کانالی که رضایت برای آن است — پیامک، بله، تلگرام
  channel   ClubChannel   @default(SMS)
  /// true = رضایت داد، false = لغو کرد
  granted   Boolean
  source    ConsentSource
  ip        String?
  userAgent String?
  note      String?
  createdAt DateTime      @default(now())

  profile ClubProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@index([channel, granted])
  @@index([createdAt])
}

/// متن قالب برای هر کانال
///
/// ⚠️ متن پیامک با متن تلگرام یکی نیست: پیامک کوتاه و بدون قالب‌بندی است،
///    تلگرام Markdown و دکمه دارد. یک متن مشترک یعنی هر دو بد می‌شوند.
///    نبود ردیف برای یک کانال = آن قالب روی آن کانال ارسال نمی‌شود
///    (به‌جز SMS که به `SmsTemplate.body` برمی‌گردد).
model TemplateChannelBody {
  id         String      @id @default(cuid())
  templateId String
  channel    ClubChannel
  body       String
  /// داده‌ی مخصوص کانال — مثل دکمه‌های تلگرام
  extra      Json?
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  template   SmsTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, channel])
  @@index([channel])
}

enum CouponType {
  PERCENT   // درصدی
  FIXED     // مبلغ ثابت
  FREE_SHIP // ارسال رایگان
}

/// کد تخفیف
///
/// جدا از تخفیف محصول (`salePrice`) است: آن روی کالا اعمال می‌شود، این روی
/// سبد. برای هدیه‌ی تولد، بازگرداندن مشتری خوابیده و مزایای سطح لازم است.
model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  title          String?
  type           CouponType @default(PERCENT)
  /// درصد (۱ تا ۱۰۰) یا مبلغ ثابت به تومان — بسته به `type`
  value          BigInt     @default(0)
  /// سقف تخفیف برای نوع درصدی — ۰ یعنی بی‌سقف
  maxDiscount    BigInt     @default(0)
  /// حداقل مبلغ سبد برای اعتبار کد
  minOrderTotal  BigInt     @default(0)

  startsAt       DateTime?
  expiresAt      DateTime?
  /// سقف کل استفاده — ۰ یعنی نامحدود
  usageLimit     Int        @default(0)
  /// سقف استفاده به‌ازای هر کاربر — ۰ یعنی نامحدود
  perUserLimit   Int        @default(1)
  usedCount      Int        @default(0)

  /// اگر پر باشد، فقط همین کاربر می‌تواند استفاده کند (کد اختصاصی تولد و ...)
  userId         String?
  /// اگر پر باشد، فقط اعضای این سطوح
  tierIds        String[]   @default([])
  /// فقط اعضایی که رضایت باشگاه دارند
  clubOnly       Boolean    @default(false)

  isActive       Boolean    @default(true)
  note           String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  redemptions    CouponRedemption[]

  @@index([isActive, expiresAt])
  @@index([userId])
}

/// مصرف یک کد تخفیف روی یک سفارش
///
/// ⚠️ `@@unique([couponId, orderId])` جلوی احتساب دوباره روی یک سفارش را
///    می‌گیرد، و شمارش `perUserLimit` از همین جدول خوانده می‌شود نه از یک
///    شمارنده‌ی جدا که ممکن است ناهمگام شود.
model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  userId     String
  orderId    String
  /// مبلغ تخفیف واقعی اعمال‌شده (تومان)
  discount   BigInt   @default(0)
  createdAt  DateTime @default(now())

  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
  @@index([userId])
  @@index([orderId])
}

model PointTransaction {
  id        String      @id @default(cuid())
  profileId String
  amount    Int         // مثبت = کسب، منفی = مصرف
  reason    PointReason
  refType   String?     // "order" | "campaign" | "instore"
  refId     String?
  note      String?
  expiresAt DateTime?
  createdAt DateTime    @default(now())

  profile   ClubProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([reason])
}

enum SmsKind {
  TRANSACTIONAL
  MARKETING
}

enum SmsSendMode {
  PATTERN
  TEXT
}

enum SmsStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

model SmsTemplate {
  id          String      @id @default(cuid())
  key         String      @unique
  title       String
  kind        SmsKind     @default(MARKETING)
  mode        SmsSendMode @default(TEXT)
  patternCode String?
  body        String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  campaigns   SmsCampaign[]
  channelBodies TemplateChannelBody[]
  automations ClubAutomation[]
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  DONE
  CANCELED
}

model SmsCampaign {
  id            String         @id @default(cuid())
  title         String
  templateId    String
  segment       Json           @default("{}")
  status        CampaignStatus @default(DRAFT)
  scheduledAt   DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  totalCount    Int            @default(0)
  sentCount     Int            @default(0)
  failedCount   Int            @default(0)
  skippedCount  Int            @default(0)
  estimatedCost BigInt         @default(0)
  createdById   String?
  createdAt     DateTime       @default(now())

  template      SmsTemplate    @relation(fields: [templateId], references: [id])
  messages      SmsMessage[]

  @@index([status])
  @@index([scheduledAt])
}

model SmsMessage {
  id               String    @id @default(cuid())
  userId           String?
  phone            String
  campaignId       String?
  automationId     String?
  templateKey      String?
  kind             SmsKind   @default(MARKETING)
  /// کانالی که پیام از آن رفت. پیش‌فرض SMS تا ردیف‌های موجود معنا داشته باشند.
  channel          ClubChannel @default(SMS)
  /// شناسه‌ی گیرنده در آن کانال — برای SMS همان `phone` است
  destination      String?
  body             String?
  lineNumber       String?
  provider         String    @default("iranpayamak")
  providerRequestId Int?
  status           SmsStatus @default(QUEUED)
  skipReason       String?
  errorMessage     String?
  cost             BigInt    @default(0)
  queuedAt         DateTime  @default(now())
  sentAt           DateTime?
  deliveredAt      DateTime?
  providerStatus   String?

  campaign         SmsCampaign? @relation(fields: [campaignId], references: [id])

  @@index([userId])
  @@index([phone])
  @@index([status])
  @@index([campaignId])
  @@index([providerRequestId])
  @@index([queuedAt])
  @@index([channel, status])
}

model SmsOptOut {
  id        String   @id @default(cuid())
  phone     String   @unique
  reason    String?
  source    String?  // "sms_reply" | "blacklist" | "admin" | "panel"
  createdAt DateTime @default(now())
}

enum ClubTrigger {
  WELCOME
  BIRTHDAY
  MEMBERSHIP_ANNIVERSARY
  AFTER_PURCHASE
  PURCHASE_FEEDBACK
  DORMANT_CUSTOMER
  TIER_UPGRADE
  POINTS_EXPIRING
}

model ClubAutomation {
  id           String      @id @default(cuid())
  trigger      ClubTrigger @unique
  templateId   String
  delayMinutes Int         @default(0)
  conditions   Json        @default("{}")
  sendHour     Int         @default(10)
  isActive     Boolean     @default(false)
  lastRunAt    DateTime?

  template     SmsTemplate @relation(fields: [templateId], references: [id])
}

model LandingPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  categoryId  String
  /// { "print-type": "laser", "usage-type": "single-function", "brand": "hp" }
  filters     Json
  title       String
  h1          String
  description String
  intro       String?
  bodyHtml    String?
  isActive    Boolean  @default(true)
  isIndexable Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([isActive, isIndexable])
}

enum RedirectMatch {
  EXACT   // /old/path            — کل مسیر برابر باشد
  PREFIX  // /old/*               — مسیر با این شروع شود، دنباله به مقصد چسبانده می‌شود
  REGEX   // ^/product/(\d+)$     — با $1 … در مقصد
}

/// ریدایرکت‌های قابل مدیریت از پنل ادمین.
///
/// `source` همیشه به شکل نرمال‌شده ذخیره می‌شود: با `/` شروع، بدون دامنه،
/// بدون query string و بدون `/` انتهایی (به‌جز خود ریشه). نرمال‌سازی در
/// `lib/redirects.ts` انجام می‌شود تا ادمین و middleware هر دو یک قاعده داشته باشند.
///
/// برای مهاجرت‌های بزرگ (چند هزار ریدایرکت) هنوز nginx گزینه‌ی بهتری است؛
/// این جدول برای ریدایرکت‌های جاری و روزمره است.
model Redirect {
  id          String        @id @default(cuid())
  source      String        @unique
  destination String
  statusCode  Int           @default(301) // 301 | 302 | 307 | 308 | 410
  matchType   RedirectMatch @default(EXACT)
  isActive    Boolean       @default(true)
  hits        Int           @default(0)
  lastHitAt   DateTime?
  note        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([isActive, matchType])
  @@index([hits])
}

/// آدرس‌هایی که ۴۰۴ گرفته‌اند، برای اینکه ادمین از روی داده‌ی واقعی
/// ریدایرکت بسازد نه حدس. `path` نرمال‌شده ذخیره می‌شود.
model NotFoundLog {
  id        String   @id @default(cuid())
  path      String   @unique
  hits      Int      @default(1)
  referer   String?
  userAgent String?
  firstSeen DateTime @default(now())
  lastSeen  DateTime @updatedAt
  ignored   Boolean  @default(false)

  @@index([ignored, hits])
  @@index([lastSeen])
}
/// برگه‌های ثابت سایت (تماس با ما، درباره ما، قوانین، سوالات متداول، ...)
/// نشانی برگه در ریشه‌ی سایت است: /{slug}
model Page {
  id             String       @id @default(cuid())
  slug           String       @unique
  title          String
  subtitle       String?
  template       PageTemplate @default(DEFAULT)
  contentHtml    String?
  coverImage     String?
  /// بلوک‌های اختیاری بسته به قالب:
  /// { contact:{phone,mobile,email,address,postalCode,workHours,mapEmbed,socials:[{label,url}]},
  ///   faq:[{q,a}], stats:[{value,label}], features:[{icon,title,text}], updatedLabel }
  blocks         Json?
  seoTitle       String?
  seoDescription String?
  isActive       Boolean      @default(true)
  isIndexable    Boolean      @default(true)
  showToc        Boolean      @default(false)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([isActive, sortOrder])
}

enum PageTemplate {
  DEFAULT /// برگه‌ی ساده: عنوان + متن
  ABOUT /// درباره ما: آمار + ویژگی‌ها
  CONTACT /// تماس با ما: کارت‌های تماس + نقشه
  FAQ /// سوالات متداول: آکاردئون + اسکیمای FAQPage
  LEGAL /// قوانین/حریم خصوصی: فهرست مطالب چسبان
}

/// ─── گزارش عملکرد ادمین ────────────────────────────────────────────────────
/// هر تغییری که یک ادمین در پنل انجام می‌دهد اینجا ثبت می‌شود تا بعداً
/// قابل استناد باشد: «محصول را گذاشتم و نیست» یا «عکس را عوض کردم» با
/// همین جدول قابل راستی‌آزمایی است.
///
/// نام و شماره‌ی ادمین **در لحظه‌ی ثبت** کپی می‌شوند تا اگر بعداً حساب حذف
/// یا تغییر نام داد، گزارش‌های قدیمی همچنان خوانا بمانند.
model ActivityLog {
  id          String         @id @default(cuid())
  actorId     String?
  actorName   String
  actorPhone  String?
  action      ActivityAction
  entity      ActivityEntity
  entityId    String?
  entityTitle String?
  /// خلاصه‌ی یک‌خطی و خوانا برای نمایش در فهرست
  summary     String?
  /// آرایه‌ی تغییرات: [{ field, label, before, after }]
  changes     Json?
  ip          String?
  createdAt   DateTime       @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  BULK_UPDATE
  UPLOAD
  LOGIN
}

enum ActivityEntity {
  PRODUCT
  CATEGORY
  BRAND
  MEDIA
  WIDGET
  PAGE
  ORDER
  STORY
  HERO_SLIDE
  BLOG
  USER
  SETTINGS
  STAFF_ROLE
  STAFF_TASK
  OTHER
}

// ═══════════════════════════════════════════════════════════════════
// کارتابل — مدیریت کار و عملکرد کارکنان
// مستندات: docs/features/staff-worklist.md
// ═══════════════════════════════════════════════════════════════════

/// دامنه‌ی کار — enum ثابت در کد چون واحد گروه‌بندی گزارش‌هاست.
/// نوعِ کار برعکس، جدول است تا مدیر بتواند بدون مهاجرت اضافه کند.
enum StaffDomain {
  SALES // فروش
  FINANCE // مالی و پرداخت
  PROCUREMENT // تأمین و خرید
  FULFILLMENT // ارسال و تحویل
  CATALOG // کاتالوگ و قیمت
  CONTENT // محتوا و بازاریابی
  SUPPORT // پشتیبانی و گارانتی
  INTERNAL // داخلی و اداری
}

enum StaffChannel {
  NONE
  CALL_IN
  CALL_OUT
  SMS
  MESSENGER
  EMAIL
  IN_PERSON
  ONLINE
}

/// از کجا این ردیف کار به وجود آمد
enum StaffTaskSource {
  MANUAL // کارمند خودش ثبت کرد
  RECURRING // قاعده‌ی تکرارشونده ساخت
  ASSIGNED // مدیر یا همکار ارجاع داد
  SYSTEM // از یک نوشتنِ واقعی در پنل استخراج می‌شود
}

/// نقش کارتابل — لایه‌ای جدا از UserRole.
///
/// ⚠️ `UserRole` عمداً دست‌نخورده می‌ماند: ۴۶ جای کد مستقیم "ADMIN" را چک
/// می‌کند و افزودن عضو تازه یعنی ریسک باز شدن مسیر ادمین. کاربری که
/// `staffRoleId` ندارد دسترسی کامل دارد، پس روز دیپلوی هیچ‌کس بیرون نمی‌افتد.
model StaffRole {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  /// کلیدهای مجوز — تعریف کلیدها در lib/permissions.ts است، ترکیبشان اینجا.
  /// مجوزی که هیچ کدی چکش نمی‌کند فقط توهم امنیت می‌سازد، پس ساخت کلید تازه
  /// از پنل ممکن نیست.
  permissions String[] @default([])
  /// نقش سیستمی حذف نمی‌شود و مجوزهایش کم نمی‌شود
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]

  @@index([isActive, sortOrder])
}

/// نوع کار — قابل افزودن توسط مدیر بدون تغییر کد.
///
/// ⚠️ هرگز حذف نمی‌شود، فقط `isActive = false` می‌گیرد. کارهای ثبت‌شده به آن
/// ارجاع دارند و حذفش گزارش‌های سال قبل را می‌شکند.
model StaffTaskType {
  id            String          @id @default(cuid())
  slug          String          @unique
  title         String
  domain        StaffDomain
  channel       StaffChannel    @default(NONE)
  source        StaffTaskSource @default(MANUAL)
  /// وقتی source = SYSTEM: کلید نگاشت به ActivityLog — lib/worklist/system-map.ts
  systemKey     String?         @unique
  icon          String?
  color         String?
  /// نتیجه‌های آماده: [{ value, label, isSuccess }]
  /// ⚠️ نتیجه دکمه است نه فیلد متنی؛ متن آزاد یعنی نمودار هرگز ساخته نمی‌شود.
  outcomes      Json            @default("[]")
  needsCustomer Boolean         @default(false)
  needsAmount   Boolean         @default(false)
  needsLink     Boolean         @default(false)
  needsCarrier  Boolean         @default(false)
  /// مهلت خودکار بر حسب دقیقه از لحظه‌ی ساخت — پیک تهران ۱۸۰، شهرستان ۱۴۴۰
  slaMinutes    Int?
  /// وزن این نوع در امتیازدهی — فاز ۶
  weight        Float           @default(1)
  isActive      Boolean         @default(true)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  tasks         StaffTask[]

  @@index([domain, isActive])
  @@index([source])
  @@index([isActive, sortOrder])
}

enum StaffTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELED
}

enum StaffPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// یک واحد کار — چه انجام‌شده چه در انتظار.
///
/// «کار» و «فعالیت انجام‌شده» عمداً یک مدل‌اند: کارِ باز همان فرمِ نیمه‌پرشده
/// است و کارمند فقط می‌بنددش. تماس هم موجودیت جدا نیست، فقط `channel` دارد.
///
/// ⚠️ تغییر وضعیت فقط از `lib/worklist/task-service.ts` انجام می‌شود.
model StaffTask {
  id            String          @id @default(cuid())
  typeId        String
  /// کپی از نوع — تا تغییر بعدیِ نوع، گزارش پارسال را جابه‌جا نکند
  domain        StaffDomain
  channel       StaffChannel    @default(NONE)
  source        StaffTaskSource @default(MANUAL)
  title         String

  /// کارمند مسئولِ فعلی — نام اسنپ‌شات است نه رابطه، مثل ActivityLog،
  /// تا حذف یا تغییر نام حساب گزارش‌های قدیمی را نشکند
  ownerId       String?
  ownerName     String
  createdById   String?
  createdByName String

  status        StaffTaskStatus @default(OPEN)
  priority      StaffPriority   @default(NORMAL)

  /// طرف مقابل — عضو باشگاه، یا فقط یک شماره، یا یک تأمین‌کننده
  customerId    String?
  contactName   String?
  contactPhone  String?
  supplierName  String?

  /// اتصال به موجودیت فروشگاه — از همان ActivityEntity استفاده می‌شود
  entity        ActivityEntity?
  entityId      String?
  linkUrl       String?
  amount        BigInt?
  carrier       String?

  /// یکی از مقادیر `outcomes` نوع کار — دکمه است نه متن آزاد
  outcome       String?
  note          String?

  /// کار فرزند: تماس فروشی که به کار خرید منجر شد
  parentId      String?
  /// قاعده‌ی تکرارشونده‌ای که این ردیف را ساخت — فاز ۳
  ruleId        String?

  dueAt         DateTime?
  /// کِی اتفاق افتاد — قابل عقب‌بردن توسط کارمند
  occurredAt    DateTime?
  doneAt        DateTime?
  /// کِی در سیستم ثبت شد — ⚠️ مبنای همه‌ی آمار عملکرد همین است، نه occurredAt.
  /// کارِ دیروز که امروز ثبت شده، کارِ امروز است.
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  type          StaffTaskType   @relation(fields: [typeId], references: [id])
  parent        StaffTask?      @relation("StaffTaskChildren", fields: [parentId], references: [id])
  children      StaffTask[]     @relation("StaffTaskChildren")
  notes         StaffTaskNote[]
  referrals     StaffTaskReferral[]

  @@index([ownerId, status, dueAt])
  @@index([status, dueAt])
  @@index([createdAt])
  @@index([domain, createdAt])
  @@index([typeId, createdAt])
  @@index([customerId, createdAt])
  @@index([entity, entityId])
  @@index([contactPhone])
  @@index([parentId])
}

/// رشته‌ی یادداشت‌های یک کار.
///
/// یادداشت‌گذاشتن کار را `IN_PROGRESS` می‌کند. نویسنده‌ی یادداشت لزوماً
/// مسئولِ کار نیست — خیلی وقت‌ها یکی کار را انجام می‌دهد و دیگری مستندش می‌کند.
model StaffTaskNote {
  id         String    @id @default(cuid())
  taskId     String
  authorId   String?
  authorName String
  body       String
  createdAt  DateTime  @default(now())
  editedAt   DateTime?

  task       StaffTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([authorId, createdAt])
}

/// تاریخچه‌ی دست‌به‌دست شدن یک کار.
///
/// جدول جداست نه یک ستون، چون یک کار ممکن است چند بار ارجاع شود
/// («علیزاده به صادقی به امیری») و تاریخچه باید کنار یادداشت‌ها دیده شود.
/// `StaffTask.ownerId` فقط **آخرین** گیرنده است؛ ردیف‌های قبلی سر جایشان می‌مانند.
///
/// ⚠️ `isUrgent` خصیصه‌ی **ارجاع** است نه کار: یک ارجاع می‌تواند فوری باشد و
/// ارجاع بعدیِ همان کار عادی. اولویت کار (`StaffTask.priority`) چیز دیگری است.
model StaffTaskReferral {
  id        String    @id @default(cuid())
  taskId    String
  fromId    String?
  fromName  String
  toId      String
  toName    String
  note      String?
  /// فوری = پاپ‌آپ برای گیرنده
  isUrgent  Boolean   @default(false)
  /// ⚠️ وقتی گیرنده عملاً ردیف را **باز کند** پر می‌شود، نه وقتی فهرست رندر
  /// شود. اگر موقع رندر علامت بزنیم، اولین refetch نشان را پیش از دیده‌شدن
  /// پاک می‌کند — این اشتباه یک بار در برتر انجام شد و در تست گرفته شد.
  seenAt    DateTime?
  createdAt DateTime  @default(now())

  task      StaffTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([toId, seenAt])
  @@index([toId, createdAt])
  @@index([taskId, createdAt])
}
