/// نظر روی مقاله‌ی مجله.
///
/// مثل `Review`، مهمان هم می‌تواند نظر بدهد (`userId` خالی، نام در `name`)
/// و هیچ نظری بدون تأیید ادمین دیده نمی‌شود.
///
/// پاسخ — چه پاسخ کاربر به کاربر، چه پاسخ رسمی فروشگاه — یک `BlogComment`
/// فرزند با `parentId` است، نه ستون جدا. برای مقاله گفتگو طبیعی است و
/// همین ساختار هر دو حالت را می‌پوشاند؛ `isStaffReply` فقط می‌گوید کدام
/// پاسخ از سمت فروشگاه است. تا امروز رابط کاربری **هر** پاسخی را
/// «پاسخ ادمین» برچسب می‌زد، که برای پاسخ یک بازدیدکننده دروغ بود.
///
/// مستندات: docs/features/reviews.md
model BlogComment {
  id           String            @id @default(cuid())
  postId       String
  userId       String?
  /// نام مهمان — فقط وقتی userId خالی است پر می‌شود
  name         String?
  /// ایمیل اختیاری مهمان؛ هرگز عمومی نمایش داده نمی‌شود
  email        String?
  content      String
  status       CommentStatus     @default(PENDING)
  parentId     String?
  /// این پاسخ از سمت فروشگاه نوشته شده است
  isStaffReply Boolean           @default(false)
  /// رأی «مفید بود» — شمارنده‌ی مادی‌شده تا مرتب‌سازی ارزان بماند
  helpfulYes   Int               @default(0)
  helpfulNo    Int               @default(0)
  /// برای تشخیص اسپم و محدودکردن ثبت پیاپی
  ip           String?
  userAgent    String?
  post         BlogPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent       BlogComment?      @relation("replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      BlogComment[]     @relation("replies")
  votes        BlogCommentVote[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt

  @@index([postId])
  @@index([status])
  @@index([parentId])
  @@index([postId, status, createdAt])
}

/// رأی «مفید بود» روی یک نظر مقاله — همان قاعده‌ی `ReviewVote`
model BlogCommentVote {
  id        String      @id @default(cuid())
  commentId String
  voterKey  String
  helpful   Boolean
  createdAt DateTime    @default(now())
  comment   BlogComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, voterKey])
  @@index([commentId])
}

