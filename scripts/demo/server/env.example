# /var/www/gardanos-demo/.env — دموی عمومی گردانوس (docs/plans/demo.md)
# ⚠️ هیچ کلید واقعی جز پیامک «کد ورود» اینجا نگذارید.

DEMO_MODE=1
DEMO_ADMIN_PHONE=09000000000

DATABASE_URL=postgresql://gardanos_demo:<رمز>@127.0.0.1:5432/gardanos_demo
JWT_SECRET=<openssl rand -hex 32>
PASSWORD_SALT=<openssl rand -hex 16>
# اتصال‌های نمایشی بازارگاه با همین کلید رمز می‌شوند
INTEGRATION_ENCRYPTION_KEY=<openssl rand -hex 32>
REDIRECT_CACHE_TOKEN=<openssl rand -hex 16>

NEXT_PUBLIC_BASE_URL=https://demo.gardanos.ir
SITE_URL=https://demo.gardanos.ir
PORT=3050

# فقط کد ورود دمو — پیامک سفارش و باشگاه در دمو فرستاده نمی‌شود
IRANPAYAMAK_API_KEY=<کلید>
IRANPAYAMAK_LINE_NUMBER=<خط>
IRANPAYAMAK_PATTERN_CODE=<کد پترن کد ورود>
